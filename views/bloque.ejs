<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero<%= bloque.heroImagen ? ' page-hero-photo' : '' %>">
    <% if (bloque.heroImagen) { %>
      <img class="page-hero-bg" src="<%= bloque.heroImagen %>" alt="" loading="eager">
      <div class="page-hero-overlay"></div>
    <% } %>
    <div class="container page-hero-content">
      <nav class="breadcrumb" aria-label="<%= t('detalle_servicio.breadcrumb.aria') %>">
        <a href="/servicios"><%= t('nav.servicios') %></a> › <%= bloque.nombre %>
      </nav>
      <span class="eyebrow"><%= t('bloque.eyebrow') %></span>
      <h1><%= bloque.nombre %></h1>
      <p><%= bloque.resumen %></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="services-grid services-grid-full">
        <% servicios.forEach(function(s){ %>
          <a href="/servicios/<%= s.slug %>" class="service-card">
            <h3><%= s.numero %>. <%= s.nombre %></h3>
            <p><%= s.resumen %></p>
            <div class="service-meta">
              <span class="meta-chip"><%= s.tiempo %></span>
            </div>
            <div class="service-card-footer">
              <span class="price-tag"><%= tv('detalle_servicio.desde_precio', { precio: fmt(s.desde), unidad: s.desdeUnidad || '' }) %></span>
              <span class="link-arrow"><%= t('bloque.ver_detalle') %></span>
            </div>
          </a>
        <% }) %>

        <% if (modosIA) { %>
          <% modosIA.forEach(function(m){ %>
            <a href="/servicios/ia-predictiva/<%= m.slug %>" class="service-card service-card-ia-modo<%= m.esProyecto ? ' service-card-ai' : '' %>">
              <% if (m.esProyecto) { %><div class="service-badge"><%= t('bloque.servicio_exclusivo') %></div><% } %>
              <% if (m.titular) { %><p class="card-titular"><%= m.titular %></p><% } %>
              <h3><%= m.numero %>. <%= m.nombre %></h3>
              <p><%= m.esProyecto ? m.subtitulo : m.resumen %></p>
              <div class="service-card-footer">
                <span class="price-tag"><%= m.esProyecto ? t('bloque.proyecto_a_medida') : tv('bloque.precio_sobre_base', { precio: fmt(m.precioIncremento) }) %></span>
                <span class="link-arrow"><%= t('bloque.ver_detalle') %></span>
              </div>
            </a>
          <% }) %>
        <% } %>

        <% if (bloque.slug === 'seguridad-ia-naves-fincas' && typeof seguridadIANaves !== 'undefined' && seguridadIANaves) { %>
          <a href="/servicios/naves-fincas/seguridad-ia" class="service-card service-card-ia-modo service-card-ai">
            <div class="service-badge"><%= t('bloque.servicio_exclusivo') %></div>
            <p class="card-titular"><%= seguridadIANaves.titular %></p>
            <h3><%= seguridadIANaves.nombre %></h3>
            <p><%= seguridadIANaves.subtitulo %></p>
            <div class="service-card-footer">
              <span class="price-tag"><%= t('bloque.proyecto_a_medida') %></span>
              <span class="link-arrow"><%= t('bloque.ver_detalle') %></span>
            </div>
          </a>
        <% } %>
      </div>

      <% if (modosIA) { %>
        <a href="/servicios/ia-predictiva" class="bloque-cta-link"><%= t('bloque.ver_instalacion_base') %></a>
      <% } %>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('tecnologia.cta.title') %></h2>
      <p><%= t('tecnologia.cta.subtitle') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent(tv('bloque.whatsapp_text', { bloque: bloque.nombre.toLowerCase() })) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
