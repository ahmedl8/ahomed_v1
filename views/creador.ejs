<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1><%= t('creador.hero.title') %></h1>
      <p><%= t('creador.hero.body') %></p>
      <p class="creador-alt-link"><%= t('creador.hero.alt_link_text') %> <a href="/configurador"><%= t('creador.hero.alt_link_cta') %></a></p>
    </div>
  </section>

  <section class="section">
    <div class="container creador-layout">
      <div class="creador-picker" data-wa="<%= empresa.whatsapp %>">

        <!-- BÁSICOS, agrupados por bloque -->
        <h2 class="sub-heading"><%= t('creador.instalaciones.title') %></h2>
        <% bloques.filter(function(b){ return b.grupo === 'basico' || b.grupo === 'general'; }).forEach(function(b){ %>
          <% var serviciosBloque = serviciosCasa.filter(function(s){ return s.bloque === b.slug; }); %>
          <% if (!serviciosBloque.length) return; %>
          <div class="creador-grupo">
            <h3 class="creador-grupo-title"><svg viewBox="0 0 24 24" class="creador-grupo-icon"><%- icons[b.icono] %></svg><%= b.nombre %></h3>
            <div class="calc-modos">
              <% serviciosBloque.forEach(function(s){ %>
                <label class="calc-item">
                  <span class="calc-item-check">
                    <input type="checkbox" class="creador-check creador-check-servicio" data-slug="<%= s.slug %>" data-precio="<%= s.desde %>" data-nombre="<%= s.nombre %>">
                    <span class="calc-item-name"><%= s.nombre %></span>
                  </span>
                  <span class="calc-item-price"><%= tv('creador.desde_precio', { precio: fmt(s.desde), unidad: s.desdeUnidad || '' }) %></span>
                </label>
              <% }) %>
            </div>
          </div>
        <% }) %>

        <!-- EXCLUSIVOS, modos IA -->
        <h2 class="sub-heading creador-ia-title"><%= t('creador.ia.title') %></h2>
        <p class="creador-ia-sub"><%= t('creador.ia.subtitle') %></p>

        <div class="calc-niveles" id="creador-niveles">
          <% instalacionBase.niveles.forEach(function(nivel, i){ %>
            <label class="calc-nivel-card">
              <input type="radio" name="creador-nivel" class="creador-nivel-radio" value="<%= nivel.total %>" data-nombre="<%= nivel.nombre %>" <%= i === 0 ? 'checked' : '' %>>
              <span class="calc-nivel-title"><%= nivel.nombre %> <span class="calc-nivel-price"><%= fmt(nivel.total) %> €</span></span>
              <span class="calc-nivel-sub"><%= nivel.subtitulo %></span>
            </label>
          <% }) %>
        </div>
        <p class="calc-nivel-hint" id="creador-nivel-hint"></p>

        <div class="creador-grupo">
          <div class="calc-modos">
            <% modos.forEach(function(m){ %>
              <label class="calc-item">
                <span class="calc-item-check">
                  <input type="checkbox" class="creador-check creador-check-modo" data-slug="<%= m.slug %>" data-precio="<%= m.esProyecto ? 860 : m.precioIncremento %>" data-nombre="<%= m.nombre %>">
                  <span class="calc-item-name"><%= m.numero %>. <%= m.nombre %><% if (m.esProyecto) { %> <em><%= t('creador.proyecto_a_medida') %></em><% } %></span>
                </span>
                <span class="calc-item-price">+<%= fmt(m.esProyecto ? 860 : m.precioIncremento) %> €</span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- RESUMEN, fijo en escritorio -->
      <aside class="creador-summary-wrap">
        <div class="calc-summary creador-summary">
          <h3><%= t('creador.resumen.title') %></h3>
          <p class="creador-empty-hint" id="creador-empty-hint"><%= t('creador.resumen.empty_hint') %></p>

          <div id="creador-match" class="creador-match" hidden>
            <span class="creador-match-label">📦 <%= t('creador.resumen.match_label') %></span>
            <p class="creador-match-body" id="creador-match-body"></p>
            <a href="#" id="creador-match-link" class="link-arrow"><%= t('creador.resumen.match_link') %></a>
          </div>

          <div class="calc-total-row" id="creador-row-basicos" hidden><span><%= t('creador.resumen.basicos') %></span><span id="creador-total-basicos">0 €</span></div>
          <div class="calc-total-row" id="creador-row-base" hidden><span id="creador-base-label"><%= t('creador.js_i18n.mini_pc_central') %></span><span id="creador-total-base">0 €</span></div>
          <div class="calc-total-row" id="creador-row-modos" hidden><span><%= t('creador.resumen.modos_ia') %></span><span id="creador-total-modos">0 €</span></div>
          <div class="calc-total-row calc-total-final"><span><%= t('creador.resumen.total_estimado') %></span><span id="creador-total">0 €</span></div>

          <a href="#" id="creador-whatsapp" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg calc-cta"><%= t('creador.resumen.cta_whatsapp') %></a>
          <p class="calc-disclaimer"><%= t('creador.resumen.disclaimer') %></p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Catálogo de packs para la detección de coincidencia -->
  <script type="application/json" id="creador-catalogo">
    <%- JSON.stringify(packsCasa.map(function(p){
      return {
        slug: p.slug,
        nombre: p.nombre,
        desde: p.opciones[0].total,
        servicios: (p.coincideCon && p.coincideCon.servicios) || [],
        modos: (p.coincideCon && p.coincideCon.modos) || []
      };
    })) %>
  </script>

  <!-- Textos usados por public/js/creador.js (resumen en vivo, mensaje de
       WhatsApp, coincidencia con packs) — resueltos en servidor vía t()/tv()
       para que el JS del cliente no tenga que hardcodear español. -->
  <script type="application/json" id="creador-i18n">
    <%- JSON.stringify({
      miniPcCentral: t('creador.js_i18n.mini_pc_central'),
      nivelHintVacio: "",
      nivelHintPro: t('creador.js_i18n.nivel_hint_pro'),
      nivelHintStart: t('creador.js_i18n.nivel_hint_start'),
      matchMejorPrecio: t('creador.js_i18n.match_mejor_precio'),
      matchDiferenciaPrefix: t('creador.js_i18n.match_diferencia_prefix'),
      matchDiferenciaSuffix: t('creador.js_i18n.match_diferencia_suffix'),
      mensajeIntro: t('creador.js_i18n.mensaje_intro'),
      mensajeBasicos: t('creador.js_i18n.mensaje_basicos'),
      mensajeModosIA: t('creador.js_i18n.mensaje_modos_ia'),
      mensajeSinNada: t('creador.js_i18n.mensaje_sin_nada'),
      mensajeTotalEstimado: t('creador.js_i18n.mensaje_total_estimado'),
      mensajeSeParece: t('creador.js_i18n.mensaje_se_parece')
    }) %>
  </script>

  <%- include('partials/footer') %>
  <script src="/js/creador.js" defer></script>
</body>
</html>
