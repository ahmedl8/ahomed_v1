<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <script type="application/ld+json">
  <%- (function(){
    var qs = [];
    for (var i = 1; i <= 11; i++) {
      qs.push({
        "@type": "Question",
        "name": t('faq.q' + i + '.q'),
        "acceptedAnswer": {
          "@type": "Answer",
          "text": (i === 4 ? empresa.zona + '.' : t('faq.q' + i + '.a')).replace(/<[^>]*>/g, '')
        }
      });
    }
    return JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": qs
    });
  })() %>
  </script>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1><%= t('faq.hero.title') %></h1>
      <p><%= t('faq.hero.subtitle') %></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="faq-list">
        <% for (var i = 1; i <= 11; i++) { %>
          <details class="faq-item">
            <summary><%= t('faq.q' + i + '.q') %></summary>
            <p><%= i === 4 ? empresa.zona + '.' : t('faq.q' + i + '.a') %></p>
          </details>
        <% } %>
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('faq.cta.title') %></h2>
      <p><%= t('faq.cta.subtitle') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('faq.cta.whatsapp_text') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
