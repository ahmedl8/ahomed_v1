<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1><%= t('faq.hero.title') %></h1>
      <p><%= t('faq.hero.subtitle') %></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="faq-list">

        <details class="faq-item">
          <summary><%= t('faq.q1.q') %></summary>
          <p><%= t('faq.q1.a') %></p>
        </details>

        <details class="faq-item">
          <summary><%= t('faq.q2.q') %></summary>
          <p><%- t('faq.q2.a') %></p>
        </details>

        <details class="faq-item">
          <summary><%= t('faq.q3.q') %></summary>
          <p><%= t('faq.q3.a') %></p>
        </details>

        <details class="faq-item">
          <summary><%= t('faq.q4.q') %></summary>
          <p><%= t('faq.q4.a') %></p>
        </details>

        <details class="faq-item">
          <summary><%= t('faq.q5.q') %></summary>
          <p><%= empresa.zona %>.</p>
        </details>

        <details class="faq-item">
          <summary><%= t('faq.q6.q') %></summary>
          <p><%= t('faq.q6.a') %></p>
        </details>

        <details class="faq-item">
          <summary><%= t('faq.q7.q') %></summary>
          <p><%= t('faq.q7.a') %></p>
        </details>

        <details class="faq-item">
          <summary><%= t('faq.q8.q') %></summary>
          <p><%= t('faq.q8.a') %></p>
        </details>

        <details class="faq-item">
          <summary><%= t('faq.q9.q') %></summary>
          <p><%= t('faq.q9.a') %></p>
        </details>

        <details class="faq-item">
          <summary><%= t('faq.q10.q') %></summary>
          <p><%= t('faq.q10.a') %></p>
        </details>

      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('faq.cta.title') %></h2>
      <p><%= t('faq.cta.subtitle') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('faq.cta.whatsapp_text') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
