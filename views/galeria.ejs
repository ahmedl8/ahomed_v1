<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1><%= t('galeria.hero.title') %></h1>
      <p><%= tv('galeria.hero.subtitle', { nombre: empresa.nombre, zona: empresa.zona }) %></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="works-grid works-grid-page">
        <% trabajos.forEach(function(t){ %>
          <a href="<%= t.enlace %>" class="work-item">
            <img src="<%= t.imagenDespues %>" alt="<%= t.titulo %>" loading="lazy">
            <div class="work-caption">
              <span class="work-cat"><%= t.categoria %></span>
              <span class="work-title"><%= t.titulo %></span>
            </div>
          </a>
        <% }) %>
      </div>
      <p class="orientative-note"><%= t('galeria.orientative_note') %></p>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('galeria.cta.title') %></h2>
      <p><%= t('galeria.cta.subtitle') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('galeria.cta.whatsapp_text') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
