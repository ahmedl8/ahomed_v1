<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>
  <% var waIcon = '<svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2z"/></svg>'; %>

  <!-- HERO -->
  <section class="hero hero-split-section">
    <div class="container hero-split">
      <div class="hero-split-copy">
        <h1><span class="hero-title-line"><%= t('home.hero.title_l1') %></span> <span class="hero-title-line"><%= t('home.hero.title_l2') %></span> <span class="hero-title-line"><%= t('home.hero.title_l3') %></span></h1>
        <p class="hero-sub"><%= tv('home.hero.subtitle', { zona: empresa.zona }) %></p>

        <div class="hero-ctas">
          <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('common.whatsapp_text_presupuesto') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
            <%- waIcon %>
            <%= t('common.hablar_whatsapp') %>
          </a>
          <a href="tel:+34<%= empresa.whatsapp %>" class="btn btn-outline-light btn-lg">
            <svg viewBox="0 0 24 24"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.4 11.4 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.58 1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
            <%= t('common.llamame') %>
          </a>
        </div>

        <div class="hero-trust-row">
          <div class="hero-trust-item"><svg viewBox="0 0 24 24"><path d="M12 1l3 6 6.5.9-4.7 4.6 1.1 6.5L12 15.9 6.1 19l1.1-6.5L2.5 7.9 9 7z"/></svg><%= t('topbar.experience_prefix') %> <%= empresa.anosExperiencia %> <%= t('topbar.experience_suffix') %></div>
          <div class="hero-trust-item"><svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg><%= empresa.zona %></div>
          <div class="hero-trust-item"><svg viewBox="0 0 24 24"><path d="M12 2l8 3.5v6c0 5.2-3.4 9.8-8 10.5-4.6-.7-8-5.3-8-10.5v-6L12 2z"/></svg><%= t('common.presupuesto_sin_compromiso') %></div>
        </div>

        <div class="hero-badges hero-badges-secondary">
          <% ['home.hero.badge1', 'home.hero.badge2', 'home.hero.badge3'].forEach(function(k){ %>
            <div class="hero-badge"><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5L4 14.2 9 19.2 20 8.2l-1.5-1.5z"/></svg><%= t(k) %></div>
          <% }) %>
        </div>
      </div>

      <div class="hero-split-visual">
        <img src="/img/hero-trabajos.jpg" alt="<%= t('home.hero.image_alt') %>" class="hero-split-img" width="1536" height="1024" />
      </div>
    </div>
  </section>

  <!-- QUÉ HACEMOS: los 7 servicios -->
  <section class="section section-tight" id="servicios">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><%= t('home.services.eyebrow') %></span>
        <h2><%= t('home.services.title') %></h2>
        <p><%= t('home.services.subtitle') %></p>
      </div>
      <div class="services-grid home-services-grid">
        <% services.forEach(function(s){ %>
          <a href="<%= pathHref('/servicios/' + s.slug) %>" class="service-card service-card-photo">
            <div class="service-card-media">
              <img src="<%= s.cardImagen %>" alt="<%= s.nombre %>" loading="lazy" width="400" height="300">
            </div>
            <div class="service-card-body">
              <h3><%= s.nombre %></h3>
              <p><%= s.resumen %></p>
              <div class="service-card-footer">
                <span class="price-tag"><%= t('common.desde') %> <%= fmt(s.desde) %> €</span>
                <span class="link-arrow"><%= t('common.ver_detalle') %> →</span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
      <p class="services-all-link"><a href="<%= pathHref('/servicios') %>" class="link-arrow"><%= t('home.services.cta_all') %> →</a></p>
    </div>
  </section>

  <!-- TRES OPCIONES, PRECIO CLARO -->
  <section class="section section-tight value-compare-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><%= t('home.options.eyebrow') %></span>
        <h2><%= t('home.options.title') %></h2>
        <p><%= t('home.options.subtitle') %></p>
      </div>
      <div class="value-compare-grid options-trio">
        <% [1,2,3].forEach(function(i){ %>
          <div class="value-compare-card">
            <h3><%= t('home.options.item' + i + '.title') %></h3>
            <p class="value-compare-with"><%= t('home.options.item' + i + '.body') %></p>
          </div>
        <% }) %>
      </div>
      <p class="value-compare-footnote"><%= t('home.options.footnote') %></p>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="section how-it-works">
    <div class="container">
      <div class="section-head">
        <h2><%= t('home.how_it_works.title') %></h2>
      </div>
      <div class="how-it-works-inner">
        <div class="how-it-works-visual">
          <picture>
            <source srcset="/img/marketing/visita-tecnica.webp" type="image/webp">
            <img src="/img/marketing/visita-tecnica.jpg" alt="<%= t('home.how_it_works.image_alt') %>" loading="lazy" width="1400" height="787">
          </picture>
        </div>
        <div class="steps-grid steps-grid-compact">
          <% comoFunciona.forEach(function(paso, i){ %>
            <div class="step-card">
              <span class="step-number"><%= String(i + 1).padStart(2, '0') %></span>
              <div class="step-copy">
                <p class="step-label"><%= paso.label %></p>
                <p class="step-desc"><%= paso.texto %></p>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- PARA PROFESIONALES -->
  <section class="section section-tight">
    <div class="container">
      <div class="configurador-banner configurador-banner-dark">
        <div class="configurador-banner-inner">
          <div class="configurador-banner-copy">
            <span class="eyebrow"><%= t('home.profesionales_teaser.eyebrow') %></span>
            <h2><%= t('home.profesionales_teaser.title') %></h2>
            <div class="configurador-banner-chips">
              <span class="configurador-banner-chip"><%= t('home.profesionales_teaser.chip_reformas') %></span>
              <span class="configurador-banner-chip"><%= t('home.profesionales_teaser.chip_constructoras') %></span>
              <span class="configurador-banner-chip"><%= t('home.profesionales_teaser.chip_interiorismo') %></span>
              <span class="configurador-banner-chip"><%= t('home.profesionales_teaser.chip_fincas') %></span>
            </div>
            <p><%= t('home.profesionales_teaser.body') %></p>
            <a href="<%= pathHref('/para-profesionales') %>" class="btn btn-primary btn-lg configurador-banner-cta"><%= t('home.profesionales_teaser.cta') %></a>
            <p class="banner-objection-note"><%- t('home.profesionales_teaser.objection') %></p>
          </div>
          <div class="configurador-banner-visual">
            <picture>
              <source srcset="/img/trabajos/reforma-general-despues.webp" type="image/webp">
              <img src="/img/trabajos/reforma-general-despues.jpg" alt="<%= t('home.profesionales_teaser.image_alt') %>" loading="lazy" width="745" height="1000">
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUIÉN HACE EL TRABAJO -->
  <section class="section about-teaser-section">
    <div class="container about-teaser-inner">
      <div class="about-teaser-photo">
        <img src="/img/ahmed-sobre-mi.jpg" alt="<%= t('home.about_teaser.image_alt') %>" loading="lazy" width="283" height="283" />
      </div>
      <div class="about-teaser-copy">
        <h2><%= t('home.about_teaser.title') %></h2>
        <p><%= tv('home.about_teaser.body', { anos: empresa.anosExperiencia }) %></p>
        <a href="<%= pathHref('/sobre-mi') %>" class="link-arrow"><%= t('home.about_teaser.cta') %></a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('home.final_cta.title') %></h2>
      <p><%= t('home.final_cta.subtitle') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('common.whatsapp_text_presupuesto') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%- waIcon %>
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
