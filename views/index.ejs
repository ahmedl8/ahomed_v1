<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <!-- HERO -->
  <section class="hero hero-split-section">
    <div class="container hero-split">
      <div class="hero-split-copy">
        <h1><%= t('home.hero.title') %></h1>
        <p class="hero-sub"><%= tv('home.hero.subtitle', { zona: empresa.zona }) %></p>

        <div class="hero-trust-row">
          <div class="hero-trust-item"><svg viewBox="0 0 24 24"><path d="M12 1l3 6 6.5.9-4.7 4.6 1.1 6.5L12 15.9 6.1 19l1.1-6.5L2.5 7.9 9 7z"/></svg><%= t('topbar.experience_prefix') %> <%= empresa.anosExperiencia %> <%= t('topbar.experience_suffix') %></div>
          <div class="hero-trust-item"><svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg><%= empresa.zona %></div>
          <div class="hero-trust-item"><svg viewBox="0 0 24 24"><path d="M12 2l8 3.5v6c0 5.2-3.4 9.8-8 10.5-4.6-.7-8-5.3-8-10.5v-6L12 2z"/></svg><%= t('common.presupuesto_sin_compromiso') %></div>
        </div>

        <div class="hero-ctas">
          <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('common.whatsapp_text_presupuesto') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
            <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2z"/></svg>
            <%= t('common.hablar_whatsapp') %>
          </a>
          <a href="tel:+34<%= empresa.whatsapp %>" class="btn btn-outline-light btn-lg">
            <svg viewBox="0 0 24 24"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.4 11.4 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.58 1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
            <%= t('common.llamame') %>
          </a>
        </div>

        <div class="hero-badges hero-badges-secondary">
          <% ['home.hero.badge1', 'home.hero.badge2', 'home.hero.badge3'].forEach(function(k){ %>
            <div class="hero-badge"><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5L4 14.2 9 19.2 20 8.2l-1.5-1.5z"/></svg><%= t(k) %></div>
          <% }) %>
        </div>
      </div>

      <div class="hero-split-visual">
        <img src="/img/hero-casa-movil.jpg" alt="<%= t('home.hero.image_alt') %>" class="hero-split-img" />
      </div>
    </div>
  </section>

  <!-- ¿QUÉ NECESITAS? -->
  <section class="section section-tight necesitas-section">
    <div class="container">
      <div class="section-head">
        <h2><%= t('home.necesitas.title') %></h2>
      </div>
      <div class="services-grid services-grid-full necesitas-grid">
        <% necesitas.forEach(function(n){ %>
          <a href="<%= n.link %>" class="service-card necesitas-card">
            <div class="service-icon service-icon-img">
              <picture>
                <source srcset="<%= n.imagen %>.webp" type="image/webp">
                <img src="<%= n.imagen %>.png" alt="<%= n.titulo %>" loading="lazy">
              </picture>
            </div>
            <h3><%= n.titulo %></h3>
            <p><%= n.subtitulo %></p>
            <% if (n.desde) { %>
              <span class="link-arrow"><%= t('common.desde') %> <%= fmt(n.desde) %> € →</span>
            <% } else { %>
              <span class="link-arrow"><%= t('common.ver_mas') %> →</span>
            <% } %>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- CONFIGURADOR DE VIVIENDA -->
  <section class="section section-tight">
    <div class="container">
      <div class="configurador-banner">
        <div class="configurador-banner-inner">
          <div class="configurador-banner-copy">
            <span class="eyebrow"><%= t('home.configurador_banner.eyebrow') %></span>
            <h2><%= t('home.configurador_banner.title') %></h2>
            <p><%= t('home.configurador_banner.body') %></p>
            <a href="/configurador" class="btn btn-primary btn-lg configurador-banner-cta"><%= t('home.configurador_banner.cta') %></a>
          </div>
          <div class="configurador-banner-visual">
            <picture>
              <source srcset="/img/marketing/configurador-tu-casa.webp" type="image/webp">
              <img src="/img/marketing/configurador-tu-casa.jpg" alt="<%= t('home.configurador_banner.image_alt') %>" loading="lazy">
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS BÁSICOS -->
  <section class="section services-strip" id="servicios">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><%= t('home.servicios.eyebrow') %></span>
        <h2><%= t('home.servicios.title') %></h2>
        <p><%= t('home.servicios.body') %></p>
      </div>

      <div class="services-grid">
        <% serviciosDestacados.forEach(function(s){ %>
          <a href="/servicios/<%= s.slug %>" class="service-card">
            <h3><%= s.nombre %></h3>
            <p><%= s.resumen %></p>
            <div class="service-card-footer">
              <span class="price-tag"><%= t('common.desde') %> <%= fmt(s.desde) %> €<%= s.desdeUnidad || '' %></span>
              <span class="link-arrow"><%= t('common.ver_detalle') %> →</span>
            </div>
          </a>
        <% }) %>
      </div>

      <a href="/servicios" class="bloque-cta-link section-cta-more"><%= t('home.servicios.ver_todos') %></a>
    </div>
  </section>

  <!-- PUENTE VISUAL ENTRE BÁSICOS Y EXCLUSIVOS -->
  <div class="section-bridge">
    <div class="section-bridge-line"></div>
    <span class="section-bridge-text"><%= t('home.bridge.text') %></span>
    <div class="section-bridge-line"></div>
  </div>

  <!-- EXCLUSIVOS · CON IA -->
  <section class="section section-exclusivos">
    <div class="container">
      <div class="section-head section-head-exclusivos">
        <span class="eyebrow"><%= t('home.exclusivos.eyebrow') %></span>
        <h2><%= t('home.exclusivos.title') %></h2>
        <p><%= tv('home.exclusivos.body', { totalModos: totalModos }) %></p>
      </div>

      <div class="cerebro-diagram">
        <div class="cerebro-intro">
          <span class="cerebro-marca cerebro-marca-lg"><%= instalacionBase.marca %></span>
          <span class="cerebro-tagline"><%= instalacionBase.tagline %></span>
        </div>

        <div class="cerebro-visual-wrap">
          <picture>
            <source srcset="/img/marketing/cerebro-ahomed.webp" type="image/webp">
            <img src="/img/marketing/cerebro-ahomed.jpg" alt="<%= t('home.exclusivos.cerebro_visual_alt') %>" loading="lazy" class="cerebro-visual-img">
          </picture>
        </div>

        <p class="cerebro-hardware-note"><%- tv('home.exclusivos.hardware_note', { precio: fmt(instalacionBase.niveles[0].total) }) %></p>

        <div class="cerebro-diagram-visual">
          <svg class="cerebro-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path class="cerebro-line" d="M50,50 Q38,36 25,24"/>
            <path class="cerebro-line" d="M50,50 Q62,36 75,24"/>
            <path class="cerebro-line" d="M50,50 Q38,64 25,76"/>
            <path class="cerebro-line" d="M50,50 Q62,64 75,76"/>
          </svg>
          <div class="cerebro-hub-icon" aria-hidden="true">
            <picture>
              <source srcset="/img/iconos/minipc-central.webp" type="image/webp">
              <img src="/img/iconos/minipc-central.png" alt="">
            </picture>
          </div>
          <div class="cerebro-branches">
            <% familiasIA.forEach(function(familia){ %>
              <a href="/servicios/ia-predictiva#familia-<%= familia.slug %>" class="cerebro-branch">
                <div class="service-icon service-icon-img">
                  <picture>
                    <source srcset="<%= familia.imagen %>.webp" type="image/webp">
                    <img src="<%= familia.imagen %>.png" alt="<%= familia.nombre %>" loading="lazy">
                  </picture>
                </div>
                <h4><%= familia.nombre %></h4>
                <p><%= familia.resumen %></p>
              </a>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="ai-highlight-inner">
        <div class="ai-highlight-copy">
          <h3><%= t('home.ai_highlight.title') %></h3>
          <p><%= seguridadIA.resumen %></p>
          <ul class="check-list">
            <li><%= t('home.ai_highlight.ideal_para_prefix') %> <%= seguridadIA.idealPara.join(', ') %></li>
            <li><%= t('home.ai_highlight.feature1') %></li>
            <li><%= t('home.ai_highlight.feature2') %></li>
          </ul>
          <a href="/servicios/ia-predictiva/seguridad-ia" class="btn btn-primary"><%= t('home.ai_highlight.cta') %></a>
        </div>
        <div class="ai-highlight-visual">
          <% if (seguridadIA.video) { %>
            <video class="modo-video" controls preload="none" poster="/img/trabajos/monitor-ia-despues.jpg">
              <source src="<%= seguridadIA.video %>" type="video/mp4">
            </video>
          <% } else { %>
            <img src="/img/trabajos/monitor-ia-despues.jpg" alt="<%= t('home.ai_highlight.video_alt') %>" loading="lazy">
          <% } %>
        </div>
      </div>

      <a href="/servicios/ia-predictiva" class="btn btn-outline ia-modos-cta"><%= tv('home.exclusivos.modos_cta', { totalModos: totalModos }) %></a>
    </div>
  </section>

  <!-- PARA PROFESIONALES (justo después de la IA: es lo segundo que más se destaca) -->
  <section class="section section-tight">
    <div class="container">
      <div class="configurador-banner configurador-banner-dark">
        <div class="configurador-banner-inner">
          <div class="configurador-banner-copy">
            <span class="launch-offer-badge launch-offer-badge-inline"><%= t('home.profesionales_teaser.badge') %></span>
            <span class="eyebrow"><%= t('home.profesionales_teaser.eyebrow') %></span>
            <h2><%= t('home.profesionales_teaser.title') %></h2>
            <div class="configurador-banner-chips">
              <span class="configurador-banner-chip"><%= t('home.profesionales_teaser.chip_reformas') %></span>
              <span class="configurador-banner-chip"><%= t('home.profesionales_teaser.chip_constructoras') %></span>
              <span class="configurador-banner-chip"><%= t('home.profesionales_teaser.chip_persianas') %></span>
              <span class="configurador-banner-chip"><%= t('home.profesionales_teaser.chip_cocinas') %></span>
              <span class="configurador-banner-chip"><%= t('home.profesionales_teaser.chip_climatizacion') %></span>
              <span class="configurador-banner-chip"><%= t('home.profesionales_teaser.chip_interiorismo') %></span>
            </div>
            <p><%= t('home.profesionales_teaser.body') %></p>
            <a href="/para-profesionales" class="btn btn-primary btn-lg configurador-banner-cta"><%= t('home.profesionales_teaser.cta') %></a>
            <p class="banner-objection-note"><%- t('home.profesionales_teaser.objection') %></p>
          </div>
          <div class="configurador-banner-visual">
            <picture>
              <source srcset="/img/trabajos/reforma-general-despues.webp" type="image/webp">
              <img src="/img/trabajos/reforma-general-despues.jpg" alt="<%= t('home.profesionales_teaser.image_alt') %>" loading="lazy">
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VIVE AHOMED · ESCENARIOS INTERACTIVOS -->
  <section class="section vive-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><%= t('home.vive.eyebrow') %></span>
        <h2><%= t('home.vive.title') %></h2>
        <p><%= t('home.vive.body') %></p>
      </div>

      <div class="escenario-tabs" role="tablist">
        <% escenarios.forEach(function(e, i){ %>
          <button type="button" class="escenario-tab<%= i === 0 ? ' is-active' : '' %>" data-escenario="<%= e.slug %>">
            <svg viewBox="0 0 24 24"><%- icons[e.icono] %></svg>
            <%= e.nombre %>
          </button>
        <% }) %>
      </div>

      <div class="escenario-panels<%= escenarios.some(function(e){ return e.media; }) ? ' escenario-panels-media' : '' %>">
        <% escenarios.forEach(function(e, i){ %>
          <div class="escenario-panel<%= i === 0 ? ' is-active' : '' %><%= e.media ? ' has-media' : '' %>" data-escenario-panel="<%= e.slug %>">
            <% if (e.media) { %>
              <div class="escenario-media">
                <video class="escenario-video" controls preload="none" poster="<%= e.media.poster %>" playsinline>
                  <source src="<%= e.media.src %>" type="video/mp4">
                </video>
              </div>
            <% } %>
            <div class="escenario-body">
              <p class="escenario-momento"><strong><%= e.nombre %>.</strong> <%= e.momento %>.</p>
              <div class="escenario-acciones">
                <% e.acciones.forEach(function(a){ %>
                  <div class="escenario-accion">
                    <span class="escenario-accion-icon"><svg viewBox="0 0 24 24"><%- icons[a.icono] %></svg></span>
                    <span><%= a.texto %></span>
                  </div>
                <% }) %>
              </div>
              <p class="escenario-explicacion"><%= e.explicacion %></p>
              <div class="escenario-links">
                <% e.modos.forEach(function(slug){ var m = modosIATodos.find(function(x){ return x.slug === slug; }); if (!m) return; %>
                  <a href="/servicios/ia-predictiva/<%= m.slug %>" class="escenario-link"><%= m.nombre %> →</a>
                <% }) %>
                <% if (e.packSugerido) { %>
                  <a href="/soluciones#<%= e.packSugerido %>" class="escenario-link"><%= t('home.escenario.ver_solucion') %></a>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- PACKS -->
  <section class="section section-tight">
    <div class="container">
      <% var pisoNuevoPack = packsDestacados.find(function(p){ return p.slug === 'piso-nuevo'; });
         var chaletSeguroPack = packsDestacados.find(function(p){ return p.slug === 'chalet-seguro'; });
         var hogarIAPack = packsDestacados.find(function(p){ return p.slug === 'hogar-inteligente'; }); %>
      <a href="/soluciones" class="soluciones-mini-banner">
        <div>
          <span class="eyebrow"><%= t('home.packs_banner.eyebrow') %></span>
          <h3><%= tv('home.packs_banner.title', { pack1: pisoNuevoPack.nombre, pack2: chaletSeguroPack.nombre, pack3: hogarIAPack.nombre }) %></h3>
        </div>
        <span class="btn btn-outline"><%= t('home.packs_banner.cta') %></span>
      </a>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="section how-it-works">
    <div class="container">
      <div class="section-head">
        <h2><%= t('home.how_it_works.title') %></h2>
      </div>
      <div class="how-it-works-inner">
        <div class="how-it-works-visual">
          <picture>
            <source srcset="/img/marketing/visita-tecnica.webp" type="image/webp">
            <img src="/img/marketing/visita-tecnica.jpg" alt="<%= t('home.how_it_works.image_alt') %>" loading="lazy">
          </picture>
        </div>
        <div class="steps-grid steps-grid-compact">
          <% comoFunciona.forEach(function(paso, i){ %>
            <div class="step-card">
              <div class="step-number"><%= i + 1 %></div>
              <p><%= paso %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- TECNOLOGÍA AHOMED -->
  <section class="section tech-teaser-section">
    <div class="container tech-teaser-inner">
      <div class="tech-teaser-copy">
        <span class="eyebrow"><%= t('home.tech_teaser.eyebrow') %></span>
        <h2><%= t('home.tech_teaser.title') %></h2>
        <p><%= t('home.tech_teaser.body') %></p>
        <div class="tech-teaser-list">
          <span class="tech-teaser-chip"><%= t('home.tech_teaser.chip1') %></span>
          <span class="tech-teaser-chip"><%= t('home.tech_teaser.chip2') %></span>
          <span class="tech-teaser-chip"><%= t('home.tech_teaser.chip3') %></span>
          <span class="tech-teaser-chip"><%= t('home.tech_teaser.chip4') %></span>
          <span class="tech-teaser-chip"><%= t('home.tech_teaser.chip5') %></span>
        </div>
        <a href="/tecnologia" class="link-arrow"><%= t('home.tech_teaser.cta') %></a>
      </div>
      <div class="tech-teaser-visual">
        <picture>
          <source srcset="/img/marketing/ia-local-privacidad.webp" type="image/webp">
          <img src="/img/marketing/ia-local-privacidad.jpg" alt="<%= t('home.tech_teaser.image_alt') %>" loading="lazy" class="tech-teaser-img" />
        </picture>
      </div>
    </div>
  </section>

  <!-- QUIÉN HACE EL TRABAJO -->
  <section class="section about-teaser-section">
    <div class="container about-teaser-inner">
      <div class="about-teaser-photo">
        <img src="/img/ahmed-sobre-mi.jpg" alt="<%= t('home.about_teaser.image_alt') %>" loading="lazy" />
      </div>
      <div class="about-teaser-copy">
        <h2><%= t('home.about_teaser.title') %></h2>
        <p><%= tv('home.about_teaser.body', { anos: empresa.anosExperiencia }) %></p>
        <a href="/sobre-mi" class="link-arrow"><%= t('home.about_teaser.cta') %></a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('home.final_cta.title') %></h2>
      <p><%= t('home.final_cta.subtitle') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('common.whatsapp_text_presupuesto') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2z"/></svg>
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('partials/footer') %>
  <script src="/js/escenarios.js" defer></script>
</body>
</html>
