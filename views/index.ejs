<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <!-- HERO -->
  <section class="hero hero-split-section">
    <div class="container hero-split">
      <div class="hero-split-copy">
        <h1>Tu casa más segura, más cómoda y más inteligente</h1>
        <p class="hero-sub">Instalaciones profesionales en <%= empresa.zona %> para viviendas y negocios: electricidad, domótica, seguridad con IA y energía solar. Soluciones a medida con atención personal.</p>

        <div class="hero-trust-row">
          <div class="hero-trust-item"><svg viewBox="0 0 24 24"><path d="M12 1l3 6 6.5.9-4.7 4.6 1.1 6.5L12 15.9 6.1 19l1.1-6.5L2.5 7.9 9 7z"/></svg>Más de <%= empresa.anosExperiencia %> de experiencia</div>
          <div class="hero-trust-item"><svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg><%= empresa.zona %></div>
          <div class="hero-trust-item"><svg viewBox="0 0 24 24"><path d="M12 2l8 3.5v6c0 5.2-3.4 9.8-8 10.5-4.6-.7-8-5.3-8-10.5v-6L12 2z"/></svg>Presupuesto sin compromiso</div>
        </div>

        <div class="hero-ctas">
          <a href="https://wa.me/34<%= empresa.whatsapp %>?text=Hola%2C%20quiero%20pedir%20presupuesto%20gratuito" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
            <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2z"/></svg>
            Hablar por WhatsApp
          </a>
          <a href="tel:+34<%= empresa.whatsapp %>" class="btn btn-outline-light btn-lg">
            <svg viewBox="0 0 24 24"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.4 11.4 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.58 1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
            Llámame
          </a>
        </div>

        <div class="hero-badges hero-badges-secondary">
          <div class="hero-badge"><svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>Instalaciones rápidas y limpias</div>
          <div class="hero-badge"><svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2z"/></svg>Atención directa por WhatsApp</div>
        </div>
      </div>

      <div class="hero-split-visual">
        <img src="/img/hero-casa-movil.jpg" alt="Vivienda con domótica y seguridad AHOMED: cámara IP exterior y app de control desde el móvil" class="hero-split-img" />
      </div>
    </div>
  </section>

  <!-- POR QUÉ ELEGIR AHOMED -->
  <section class="section advantages-section">
    <div class="container">
      <div class="section-head">
        <h2>¿Por qué elegir AHOMED?</h2>
      </div>
      <div class="advantages-grid">
        <% ventajas.forEach(function(v){ %>
          <div class="advantage-item">
            <svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5L4 14.2 9 19.2 20 8.2l-1.5-1.5z"/></svg>
            <span><%= v %></span>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- SERVICIOS BÁSICOS -->
  <section class="section services-strip" id="servicios">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Instalaciones tradicionales</span>
        <h2>Básicos — trabajos sin IA</h2>
        <p>Se piden sueltos, sin ningún equipo obligatorio de por medio</p>
      </div>

      <div class="services-grid">
        <% services.forEach(function(s){ %>
          <a href="/servicios/<%= s.slug %>" class="service-card">
            <h3><%= s.nombre %></h3>
            <p><%= s.resumen %></p>
            <div class="service-card-footer">
              <span class="price-tag">Desde <%= fmt(s.desde) %> €<%= s.desdeUnidad || '' %></span>
              <span class="link-arrow">Ver detalle →</span>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- PUENTE VISUAL ENTRE BÁSICOS Y EXCLUSIVOS -->
  <div class="section-bridge">
    <div class="section-bridge-line"></div>
    <span class="section-bridge-text">Y si quieres que todo esto piense por sí solo…</span>
    <div class="section-bridge-line"></div>
  </div>

  <!-- EXCLUSIVOS · CON IA -->
  <section class="section section-exclusivos">
    <div class="container">
      <div class="section-head section-head-exclusivos">
        <span class="eyebrow">El gran diferenciador de AHOMED</span>
        <h2>Exclusivos — con Inteligencia Artificial</h2>
        <p>Tu casa te avisa solo cuando de verdad importa — nada de alertas por un gato o una sombra. <%= totalModos %> modos a elegir, desde seguridad hasta cuidado de mayores o mascotas, todos sobre el mismo Mini-PC IA Central (desde 590 €).</p>
      </div>

      <div class="ai-highlight-inner">
        <div class="ai-highlight-copy">
          <h3>Seguridad IA — el más pedido</h3>
          <p><%= seguridadIA.resumen %></p>
          <ul class="check-list">
            <li>Ideal para: <%= seguridadIA.idealPara.join(', ') %></li>
            <li>Configuración del modelo de detección entrenado con imágenes reales de tu local o vivienda</li>
            <li>Notificaciones por WhatsApp solo cuando de verdad importa</li>
          </ul>
          <a href="/servicios/ia-predictiva/seguridad-ia" class="btn btn-primary">Ver ejemplos y precios</a>
        </div>
        <div class="ai-highlight-visual">
          <% if (seguridadIA.video) { %>
            <video class="modo-video" controls preload="none" poster="/img/trabajos/monitor-ia-despues.jpg">
              <source src="<%= seguridadIA.video %>" type="video/mp4">
            </video>
          <% } else { %>
            <img src="/img/trabajos/monitor-ia-despues.jpg" alt="Sistema de videovigilancia con detección de personas y vehículos por IA y alertas por WhatsApp" loading="lazy">
          <% } %>
        </div>
      </div>

      <h3 class="ia-modos-strip-title">Y otros <%= modosIA.length %> modos, sobre el mismo Mini-PC IA Central</h3>
      <div class="ia-modos-strip">
        <% modosIA.forEach(function(m){ %>
          <a href="/servicios/ia-predictiva/<%= m.slug %>" class="ia-modo-chip">
            <span class="ia-modo-chip-num"><%= m.numero %></span>
            <span class="ia-modo-chip-name"><%= m.nombre %></span>
            <span class="ia-modo-chip-price">+<%= fmt(m.precioIncremento) %> €</span>
          </a>
        <% }) %>
      </div>

      <a href="/servicios/ia-predictiva" class="btn btn-outline ia-modos-cta">Configura tu Plataforma IA →</a>
    </div>
  </section>

  <!-- PACKS -->
  <section class="section packs-section">
    <div class="container">
      <div class="section-head">
        <h2>Packs AHOMED</h2>
        <p>No vendemos solo servicios sueltos: resolvemos la instalación completa.</p>
      </div>
      <div class="packs-grid">
        <% packs.forEach(function(p){ %>
          <a href="/packs#<%= p.slug %>" class="pack-card pack-card-photo">
            <img src="<%= p.imagen %>" alt="<%= p.imagenAlt %>" loading="lazy" class="pack-card-img">
            <div class="pack-card-body">
              <% if (p.incluyeIA) { %><span class="pack-ia-badge pack-ia-badge-sm">🧠 Incluye IA</span><% } %>
              <h3><%= p.nombre %></h3>
              <p class="pack-desc"><%= p.descripcion %></p>
              <div class="pack-footer">
                <span class="price-tag price-tag-lg">Desde <%= fmt(p.opciones[0].total) %> €</span>
                <span class="btn btn-outline">Ver desglose</span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="section how-it-works">
    <div class="container">
      <div class="section-head">
        <h2>Cómo funciona un presupuesto AHOMED</h2>
      </div>
      <div class="steps-grid">
        <% comoFunciona.forEach(function(paso, i){ %>
          <div class="step-card">
            <div class="step-number"><%= i + 1 %></div>
            <p><%= paso %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- QUIÉN HACE EL TRABAJO -->
  <section class="section about-teaser-section">
    <div class="container about-teaser-inner">
      <div class="about-teaser-photo">
        <img src="/img/ahmed-sobre-mi.jpg" alt="Ahmed, técnico y fundador de AHOMED" loading="lazy" />
      </div>
      <div class="about-teaser-copy">
        <h2>Quién viene a tu casa</h2>
        <p>Soy Ahmed, técnico con más de <%= empresa.anosExperiencia %> de experiencia en electricidad, domótica y sistemas de seguridad con IA. Soy quien valora tu proyecto en la visita técnica y con quien hablas directamente por WhatsApp, de principio a fin.</p>
        <a href="/sobre-mi" class="link-arrow">Conoce mi experiencia completa →</a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2>¿Hablamos de tu proyecto?</h2>
      <p>Primera visita gratuita. Presupuesto sin compromiso.</p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=Hola%2C%20quiero%20pedir%20presupuesto%20gratuito" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2z"/></svg>
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
