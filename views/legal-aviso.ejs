<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1><%= t('legal.aviso.hero.title') %></h1>
      <p><%- tv('legal.aviso.hero.subtitle', { web: empresa.web }) %></p>
      <div class="legal-nav">
        <a href="<%= pathHref('/aviso-legal') %>"><%= t('legal.nav.aviso') %></a>
        <a href="<%= pathHref('/privacidad') %>"><%= t('legal.nav.privacidad') %></a>
        <a href="<%= pathHref('/cookies') %>"><%= t('legal.nav.cookies') %></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container legal-content">

      <!-- TODO: sustituir por los datos fiscales definitivos (nombre completo/razón social, NIF/CIF, domicilio fiscal) en cuanto se formalice el alta como autónomo o sociedad. -->
      <span class="legal-pending"><%- tv('legal.aviso.pending', { email: empresa.email }) %></span>

      <h2 class="sub-heading"><%= t('legal.aviso.s1.title') %></h2>
      <p><%- tv('legal.aviso.s1.body', {
            nombre: empresa.nombre,
            zona: empresa.zona,
            email: empresa.email,
            whatsapp: empresa.whatsapp,
            whatsappDisplay: empresa.whatsappDisplay
          }) %></p>

      <h2 class="sub-heading"><%= t('legal.aviso.s2.title') %></h2>
      <p><%- tv('legal.aviso.s2.body', { web: empresa.web, nombre: empresa.nombre }) %></p>

      <h2 class="sub-heading"><%= t('legal.aviso.s3.title') %></h2>
      <p><%= t('legal.aviso.s3.body') %></p>

      <h2 class="sub-heading"><%= t('legal.aviso.s4.title') %></h2>
      <p><%- tv('legal.aviso.s4.body', { nombre: empresa.nombre }) %></p>

      <h2 class="sub-heading"><%= t('legal.aviso.s5.title') %></h2>
      <p><%- tv('legal.aviso.s5.body', { nombre: empresa.nombre }) %></p>

      <h2 class="sub-heading"><%= t('legal.aviso.s6.title') %></h2>
      <p><%= t('legal.aviso.s6.body') %></p>

      <p><%- tv('legal.aviso.footer_links', {
            privacidad_href: pathHref('/privacidad'),
            privacidad_label: t('legal.nav.privacidad_lower'),
            cookies_href: pathHref('/cookies'),
            cookies_label: t('legal.nav.cookies_lower')
          }) %></p>

    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
