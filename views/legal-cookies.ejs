<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1><%= t('legal.cookies.hero.title') %></h1>
      <p><%- tv('legal.cookies.hero.subtitle', { web: empresa.web }) %></p>
      <div class="legal-nav">
        <a href="<%= pathHref('/aviso-legal') %>"><%= t('legal.nav.aviso') %></a>
        <a href="<%= pathHref('/privacidad') %>"><%= t('legal.nav.privacidad') %></a>
        <a href="<%= pathHref('/cookies') %>"><%= t('legal.nav.cookies') %></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container legal-content">

      <h2 class="sub-heading"><%= t('legal.cookies.s1.title') %></h2>
      <p><%= t('legal.cookies.s1.body') %></p>

      <h2 class="sub-heading"><%= t('legal.cookies.s2.title') %></h2>
      <p><%= t('legal.cookies.s2.intro') %></p>
      <ul class="dot-list">
        <li><%- t('legal.cookies.s2.li1') %></li>
      </ul>
      <p><%= t('legal.cookies.s2.outro') %></p>

      <h2 class="sub-heading"><%= t('legal.cookies.s3.title') %></h2>
      <p><%= t('legal.cookies.s3.body') %></p>

      <h2 class="sub-heading"><%= t('legal.cookies.s4.title') %></h2>
      <p><%= t('legal.cookies.s4.body') %></p>
      <p><button type="button" id="cookie-reopen" class="btn btn-outline btn-sm"><%= t('legal.cookies.s4.change_button') %></button></p>
      <ul class="dot-list">
        <li><a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener">Google Chrome</a></li>
        <li><a href="https://support.mozilla.org/<%= lang %>/kb/habilitar-y-deshabilitar-cookies-sitios-web-rastrear-preferencias" target="_blank" rel="noopener">Mozilla Firefox</a></li>
        <li><a href="https://support.apple.com/<%= lang === 'es' ? 'es-es' : (lang === 'fr' ? 'fr-fr' : 'en-us') %>/guide/safari/sfri11471/mac" target="_blank" rel="noopener">Safari</a></li>
        <li><a href="https://support.microsoft.com/<%= lang === 'es' ? 'es-es' : (lang === 'fr' ? 'fr-fr' : 'en-us') %>/microsoft-edge" target="_blank" rel="noopener">Microsoft Edge</a></li>
      </ul>

      <h2 class="sub-heading"><%= t('legal.cookies.s5.title') %></h2>
      <p><%- tv('legal.cookies.s5.body', { email: empresa.email }) %></p>

      <p class="orientative-note"><%= t('legal.cookies.last_updated') %></p>

    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
