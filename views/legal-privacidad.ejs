<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1><%= t('legal.privacidad.hero.title') %></h1>
      <p><%- tv('legal.privacidad.hero.subtitle', { web: empresa.web }) %></p>
      <div class="legal-nav">
        <a href="<%= pathHref('/aviso-legal') %>"><%= t('legal.nav.aviso') %></a>
        <a href="<%= pathHref('/privacidad') %>"><%= t('legal.nav.privacidad') %></a>
        <a href="<%= pathHref('/cookies') %>"><%= t('legal.nav.cookies') %></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container legal-content">

      <!-- TODO: sustituir por los datos fiscales definitivos del responsable del tratamiento en cuanto se formalice el alta como autónomo o sociedad. -->
      <span class="legal-pending"><%- tv('legal.privacidad.pending', { email: empresa.email }) %></span>

      <h2 class="sub-heading"><%= t('legal.privacidad.s1.title') %></h2>
      <p><%- tv('legal.privacidad.s1.body', { nombre: empresa.nombre, zona: empresa.zona, email: empresa.email }) %></p>

      <h2 class="sub-heading"><%= t('legal.privacidad.s2.title') %></h2>
      <p><%= t('legal.privacidad.s2.body1') %></p>
      <p><%- tv('legal.privacidad.s2.body2', { cookies_href: pathHref('/cookies'), cookies_label: t('legal.nav.cookies_lower') }) %></p>

      <h2 class="sub-heading"><%= t('legal.privacidad.s3.title') %></h2>
      <p><%- tv('legal.privacidad.s3.body', { cookies_href: pathHref('/cookies'), cookies_label: t('legal.nav.cookies_lower') }) %></p>

      <h2 class="sub-heading"><%= t('legal.privacidad.s4.title') %></h2>
      <p><%= t('legal.privacidad.s4.intro') %></p>
      <ul class="dot-list">
        <li><%- t('legal.privacidad.s4.li1') %></li>
        <li><%- t('legal.privacidad.s4.li2') %></li>
      </ul>
      <p><%= t('legal.privacidad.s4.outro') %></p>

      <h2 class="sub-heading"><%= t('legal.privacidad.s5.title') %></h2>
      <p><%= t('legal.privacidad.s5.body') %></p>

      <h2 class="sub-heading"><%= t('legal.privacidad.s6.title') %></h2>
      <p><%- tv('legal.privacidad.s6.body', { email: empresa.email }) %></p>

      <h2 class="sub-heading"><%= t('legal.privacidad.s7.title') %></h2>
      <p><%= t('legal.privacidad.s7.body') %></p>

      <h2 class="sub-heading"><%= t('legal.privacidad.s8.title') %></h2>
      <p><%= t('legal.privacidad.s8.body') %></p>

      <h2 class="sub-heading"><%= t('legal.privacidad.s9.title') %></h2>
      <p><%= t('legal.privacidad.s9.body') %></p>

      <p class="orientative-note"><%= t('legal.privacidad.last_updated') %></p>

    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
