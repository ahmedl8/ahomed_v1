<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1>Packs AHOMED</h1>
      <p>Instalaciones completas a precio cerrado. Cada pack combina los servicios que más se piden juntos: una sola visita, un solo presupuesto, sin sorpresas.</p>
    </div>
  </section>

  <% packs.forEach(function(p, pi){ %>
  <section id="<%= p.slug %>" class="section pack-detail-section <%= pi % 2 === 1 ? 'pack-detail-alt' : '' %>">
    <div class="container">

      <div class="pack-detail-head">
        <span class="eyebrow">Pack <%= pi + 1 %> de <%= packs.length %></span>
        <h2><%= p.nombre %></h2>
        <p class="pack-detail-desc"><%= p.descripcion %></p>
      </div>

      <div class="pack-photo-pair">
        <div class="pack-photo-wrap">
          <span class="photo-label">Antes</span>
          <img src="<%= p.imagenAntes %>" alt="Antes — <%= p.imagenAlt %>" loading="lazy">
        </div>
        <div class="pack-photo-wrap">
          <span class="photo-label photo-label-after">Después</span>
          <img src="<%= p.imagen %>" alt="<%= p.imagenAlt %>" loading="lazy">
        </div>
      </div>

      <div class="options-stack options-stack-3">
        <% p.opciones.forEach(function(op){ %>
          <div class="option-card <%= op.destacada ? 'option-card-featured' : '' %>">
            <% if (op.destacada) { %><span class="option-star">⭐ Recomendada</span><% } %>
            <h3><%= op.nombre %></h3>
            <table class="option-table">
              <tbody>
                <% op.items.forEach(function(item){ %>
                  <tr>
                    <td><%= item[0] %></td>
                    <td class="option-price"><%= fmt(item[1]) %> €</td>
                  </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr>
                  <td>TOTAL PACK</td>
                  <td class="option-price option-total"><%= fmt(op.total) %> €</td>
                </tr>
              </tfoot>
            </table>
            <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent('Hola, me interesa el ' + p.nombre + ' — opción ' + op.nombre.split('—')[0].trim()) %>"
               target="_blank" rel="noopener"
               class="btn btn-whatsapp pack-option-cta wa-counter-btn">
              <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2z"/></svg>
              Pedir presupuesto
            </a>
          </div>
        <% }) %>
      </div>

      <% if (p.nota) { %>
        <p class="pack-note-bottom"><%= p.nota %></p>
      <% } %>
      <p class="orientative-note">Todos los importes son orientativos. El precio definitivo se confirma tras la visita técnica gratuita.</p>

    </div>
  </section>
  <% }) %>

  <%- include('partials/footer') %>
</body>
</html>
