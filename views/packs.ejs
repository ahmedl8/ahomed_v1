<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1><%= t('packs.hero.title') %></h1>
      <p><%= t('packs.hero.subtitle') %></p>
      <p class="creador-alt-link"><%- t('packs.hero.alt_link') %></p>
    </div>
  </section>

  <section class="section-group-header" id="packs-casa">
    <div class="container">
      <span class="section-group-eyebrow"><%= t('packs.casa.eyebrow') %></span>
      <h2 class="section-group-title"><%= t('packs.casa.title') %></h2>
      <p class="section-group-desc"><%= t('packs.casa.desc') %></p>
    </div>
  </section>

  <% packsCasa.forEach(function(p, pi){ %>
  <section id="<%= p.slug %>" class="section pack-detail-section <%= pi % 2 === 1 ? 'pack-detail-alt' : '' %>">
    <div class="container">

      <div class="pack-detail-head">
        <span class="eyebrow"><%= tv('packs.casa.pack_label', { n: pi + 1, total: packsCasa.length }) %></span>
        <% if (p.incluyeIA) { %><span class="pack-ia-badge"><%= t('packs.badge.incluye_ia') %></span><% } %>
        <h2><%= p.nombre %></h2>
        <p class="pack-detail-desc"><%= p.descripcion %></p>
        <% if (p.idealPara || p.resultado) { %>
          <div class="pack-detail-meta">
            <% if (p.idealPara) { %><p><strong><%= t('packs.detail.ideal_para') %></strong> <%= p.idealPara %></p><% } %>
            <% if (p.resultado) { %><p><strong><%= t('packs.detail.resultado') %></strong> <%= p.resultado %></p><% } %>
          </div>
        <% } %>
      </div>

      <% if (p.imagenAntes) { %>
        <div class="pack-photo-pair">
          <div class="pack-photo-wrap">
            <span class="photo-label"><%= t('packs.photo.antes') %></span>
            <img src="<%= p.imagenAntes %>" alt="<%= t('packs.photo.antes') %> — <%= p.imagenAlt %>" loading="lazy">
          </div>
          <div class="pack-photo-wrap">
            <span class="photo-label photo-label-after"><%= t('packs.photo.despues') %></span>
            <img src="<%= p.imagen %>" alt="<%= p.imagenAlt %>" loading="lazy">
          </div>
        </div>
      <% } else { %>
        <div class="pack-photo-single">
          <img src="<%= p.imagen %>" alt="<%= p.imagenAlt %>" loading="lazy">
        </div>
      <% } %>

      <div class="options-stack options-stack-3">
        <% p.opciones.forEach(function(op){ %>
          <%
            var waText = encodeURIComponent(tv('packs.whatsapp_intent', { pack: p.nombre, opcion: op.nombre.split('—')[0].trim() }));
            var ctaHtml = '<a href="https://wa.me/34' + empresa.whatsapp + '?text=' + waText + '" target="_blank" rel="noopener" class="btn btn-whatsapp pack-option-cta wa-counter-btn"><svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2z"/></svg>' + t('nav.pedir_presupuesto') + '</a>';
          %>
          <%- include('partials/option-card', { op: op, fmt: fmt, ctaHtml: ctaHtml }) %>
        <% }) %>
      </div>

      <% if (p.nota) { %>
        <p class="pack-note-bottom"><%= p.nota %></p>
      <% } %>
      <p class="orientative-note"><%= t('packs.orientative_note') %></p>

    </div>
  </section>
  <% }) %>

  <section class="section-group-header section-group-header-neutral" id="packs-negocio">
    <div class="container">
      <span class="section-group-eyebrow"><%= t('packs.negocio.eyebrow') %></span>
      <h2 class="section-group-title"><%= t('packs.negocio.title') %></h2>
      <p class="section-group-desc"><%= t('packs.negocio.desc') %></p>
    </div>
  </section>

  <% packsNegocio.forEach(function(p, pi){ %>
  <section id="<%= p.slug %>" class="section pack-detail-section <%= pi % 2 === 1 ? 'pack-detail-alt' : '' %>">
    <div class="container">

      <div class="pack-detail-head">
        <span class="eyebrow"><%= tv('packs.negocio.pack_label', { n: pi + 1, total: packsNegocio.length }) %></span>
        <% if (p.incluyeIA) { %><span class="pack-ia-badge"><%= t('packs.badge.incluye_ia') %></span><% } %>
        <h2><%= p.nombre %></h2>
        <p class="pack-detail-desc"><%= p.descripcion %></p>
        <% if (p.idealPara || p.resultado) { %>
          <div class="pack-detail-meta">
            <% if (p.idealPara) { %><p><strong><%= t('packs.detail.ideal_para') %></strong> <%= p.idealPara %></p><% } %>
            <% if (p.resultado) { %><p><strong><%= t('packs.detail.resultado') %></strong> <%= p.resultado %></p><% } %>
          </div>
        <% } %>
      </div>

      <% if (p.imagenAntes) { %>
        <div class="pack-photo-pair">
          <div class="pack-photo-wrap">
            <span class="photo-label"><%= t('packs.photo.antes') %></span>
            <img src="<%= p.imagenAntes %>" alt="<%= t('packs.photo.antes') %> — <%= p.imagenAlt %>" loading="lazy">
          </div>
          <div class="pack-photo-wrap">
            <span class="photo-label photo-label-after"><%= t('packs.photo.despues') %></span>
            <img src="<%= p.imagen %>" alt="<%= p.imagenAlt %>" loading="lazy">
          </div>
        </div>
      <% } else { %>
        <div class="pack-photo-single">
          <img src="<%= p.imagen %>" alt="<%= p.imagenAlt %>" loading="lazy">
        </div>
      <% } %>

      <div class="options-stack options-stack-3">
        <% p.opciones.forEach(function(op){ %>
          <%
            var waText = encodeURIComponent(tv('packs.whatsapp_intent', { pack: p.nombre, opcion: op.nombre.split('—')[0].trim() }));
            var ctaHtml = '<a href="https://wa.me/34' + empresa.whatsapp + '?text=' + waText + '" target="_blank" rel="noopener" class="btn btn-whatsapp pack-option-cta wa-counter-btn"><svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2z"/></svg>' + t('nav.pedir_presupuesto') + '</a>';
          %>
          <%- include('partials/option-card', { op: op, fmt: fmt, ctaHtml: ctaHtml }) %>
        <% }) %>
      </div>

      <% if (p.nota) { %>
        <p class="pack-note-bottom"><%= p.nota %></p>
      <% } %>
      <p class="orientative-note"><%= t('packs.orientative_note') %></p>

    </div>
  </section>
  <% }) %>

  <%- include('partials/footer') %>
</body>
</html>
