<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero page-hero-photo">
    <img src="/img/hero-bloques/reparaciones-reformas.jpg" width="1536" height="1024" alt="<%= t('profesionales.hero.image_alt') %>" class="page-hero-bg" loading="eager" />
    <div class="page-hero-overlay"></div>
    <div class="container page-hero-content">
      <span class="eyebrow"><%= t('profesionales.hero.eyebrow') %></span>
      <h1><%= t('profesionales.hero.title1') %><br><%= t('profesionales.hero.title2') %></h1>
      <p><%= t('profesionales.hero.body') %></p>
      <div class="hero-ctas">
        <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('profesionales.whatsapp_text') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
          <%= t('common.hablar_whatsapp') %>
        </a>
      </div>
    </div>
  </section>

  <!-- POR QUÉ COLABORAR -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2><%= t('profesionales.why.title') %></h2>
        <p class="section-group-desc"><%= t('profesionales.why.body') %></p>
      </div>
      <div class="services-grid services-grid-full">
        <div class="service-card">
          <div class="service-icon"><svg viewBox="0 0 24 24"><%- icons.wrench %></svg></div>
          <h3><%= t('profesionales.why.card1.title') %></h3>
          <p><%= t('profesionales.why.card1.body') %></p>
        </div>
        <div class="service-card">
          <div class="service-icon"><svg viewBox="0 0 24 24"><%- icons.shield %></svg></div>
          <h3><%= t('profesionales.why.card2.title') %></h3>
          <p><%= t('profesionales.why.card2.body') %></p>
        </div>
        <div class="service-card">
          <div class="service-icon"><svg viewBox="0 0 24 24"><%- icons.bolt %></svg></div>
          <h3><%= t('profesionales.why.card3.title') %></h3>
          <p><%= t('profesionales.why.card3.body') %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- MODELOS DE COLABORACIÓN -->
  <section class="section section-alt" id="como-funciona">
    <div class="container">
      <div class="section-head">
        <h2><%= t('profesionales.modelos.title') %></h2>
        <p class="section-group-desc"><%= t('profesionales.modelos.body') %></p>
      </div>
      <div class="services-grid services-grid-full">
        <div class="about-card">
          <h3><%= t('profesionales.modelos.item1.title') %></h3>
          <p><%= t('profesionales.modelos.item1.body') %></p>
        </div>
        <div class="about-card">
          <h3><%= t('profesionales.modelos.item2.title') %></h3>
          <p><%= t('profesionales.modelos.item2.body') %></p>
        </div>
        <div class="about-card">
          <h3><%= t('profesionales.modelos.item3.title') %></h3>
          <p><%= t('profesionales.modelos.item3.body') %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- QUÉ CUBRE AHOMED -->
  <section class="section">
    <div class="container two-col">
      <div>
        <h2 class="sub-heading"><%= t('profesionales.aporta.title') %></h2>
        <p><%= t('profesionales.aporta.body') %></p>
        <ul class="dot-list dot-list-cols">
          <% services.forEach(function(s){ %>
            <li><a href="<%= pathHref('/servicios/' + s.slug) %>"><%= s.nombre %></a></li>
          <% }) %>
        </ul>
      </div>

      <div class="about-side">
        <div class="about-card">
          <h3><%= t('profesionales.aporta.side_title') %></h3>
          <ul class="check-list check-list-lg">
            <% [1,2,3,4,5,6].forEach(function(i){ %>
              <li><%= t('profesionales.aporta.tipo' + i) %></li>
            <% }) %>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PROYECTO PILOTO -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <h2><%= t('profesionales.piloto.title') %></h2>
        <p class="section-group-desc"><%= t('profesionales.piloto.body') %></p>
      </div>
      <div class="services-grid services-grid-full">
        <% [1,2,3,4].forEach(function(i){ %>
          <div class="service-card">
            <h3><%= t('profesionales.piloto.item' + i + '.title') %></h3>
            <p><%= t('profesionales.piloto.item' + i + '.body') %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('profesionales.final.title') %></h2>
      <p><%= t('profesionales.final.body') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('profesionales.whatsapp_text') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg"><%= t('common.hablar_whatsapp') %></a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
