<%# Bloque «Cuéntanos qué necesitas y te llamamos»: el cliente escribe su necesidad y, al enviar, se abre
    WhatsApp con el mensaje ya redactado (public/js/main.js, form[data-wa-form]). También ofrece llamar.
    Sin precios: el presupuesto se da en persona tras la visita gratuita.
    Locals: t, tv, empresa; opcionales `servicio` (nombre del servicio) y `lugar` (analítica / id único). %>
<%
  var _servicio = (typeof servicio !== 'undefined' && servicio) ? servicio : '';
  var _lugar = (typeof lugar !== 'undefined' && lugar) ? lugar : 'home';
  var _prefijo = _servicio
    ? tv('visita.form.prefijo_servicio', { servicio: _servicio.toLowerCase() })
    : t('visita.form.prefijo');
%>
<section class="section section-tight visita-cta-section" id="visita-<%= _lugar %>">
  <div class="container">
    <div class="visita-card">
      <div class="visita-copy">
        <span class="eyebrow"><%= t('visita.eyebrow') %></span>
        <h2><%= t('visita.title') %></h2>
        <p><%= t('visita.subtitle') %></p>
        <ul class="visita-points">
          <li><%= t('visita.point1') %></li>
          <li><%= t('visita.point2') %></li>
          <li><%= t('visita.point3') %></li>
        </ul>
      </div>
      <form class="visita-form" data-wa-form data-wa-numero="34<%= empresa.whatsapp %>" data-wa-prefijo="<%= _prefijo %>" data-lugar="<%= _lugar %>" data-servicio="<%= _servicio %>" novalidate>
        <label for="necesidad-<%= _lugar %>"><%= t('visita.form.label') %></label>
        <textarea id="necesidad-<%= _lugar %>" name="necesidad" rows="4" maxlength="600" required placeholder="<%= t('visita.form.placeholder') %>" data-vacio="<%= t('visita.form.vacio') %>"></textarea>
        <button type="submit" class="btn btn-whatsapp btn-lg">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2zm0 18.15a8.13 8.13 0 0 1-4.146-1.135l-.297-.176-3.05.881.897-2.968-.193-.306A8.14 8.14 0 1 1 20.14 12a8.15 8.15 0 0 1-8.139 8.15z"/></svg>
          <%= t('visita.form.enviar') %>
        </button>
        <p class="visita-nota"><%= t('visita.form.nota') %></p>
        <a href="tel:+34<%= empresa.whatsapp %>" class="visita-call" data-gtm-event="clic_llamada" data-lugar="<%= _lugar %>" data-servicio="<%= _servicio %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.4 11.4 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.58 1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
          <%= tv('visita.form.o_llamar', { tel: empresa.whatsappDisplay }) %>
        </a>
      </form>
    </div>
  </div>
</section>
