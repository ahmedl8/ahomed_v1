<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand">
        <img src="/img/logo-white.png" alt="AHOMED" class="brand-logo brand-logo-footer" />
      </div>
      <p class="footer-tag"><%= t('footer.tag') %></p>
    </div>

    <div class="footer-col">
      <h4><%= t('footer.servicios') %></h4>
      <a href="<%= pathHref('/servicios/electricidad') %>"><%= t('footer.electricidad') %></a>
      <a href="<%= pathHref('/servicios/domotica') %>"><%= t('footer.domotica') %></a>
      <a href="<%= pathHref('/servicios/seguridad') %>"><%= t('footer.seguridad') %></a>
      <a href="<%= pathHref('/servicios/ia-predictiva') %>"><%= t('footer.plataforma_ia') %></a>
      <a href="<%= pathHref('/servicios/energia-solar') %>"><%= t('footer.energia_solar') %></a>
      <a href="<%= pathHref('/servicios/mantenimiento') %>"><%= t('footer.mantenimiento') %></a>
      <a href="<%= pathHref('/servicios') %>"><%= t('footer.ver_todos') %></a>
    </div>

    <div class="footer-col">
      <h4><%= t('footer.empresa') %></h4>
      <a href="<%= pathHref('/configurador') %>"><%= t('footer.configurador') %></a>
      <a href="<%= pathHref('/crea-tu-instalacion') %>"><%= t('footer.crea_instalacion') %></a>
      <a href="<%= pathHref('/tecnologia') %>"><%= t('footer.tecnologia') %></a>
      <a href="<%= pathHref('/sobre-mi') %>"><%= t('footer.sobre_mi') %></a>
      <a href="<%= pathHref('/soluciones') %>"><%= t('footer.soluciones') %></a>
      <a href="<%= pathHref('/para-profesionales') %>"><%= t('footer.para_profesionales') %></a>
      <a href="<%= pathHref('/preguntas-frecuentes') %>"><%= t('footer.faq') %></a>
      <a href="<%= pathHref('/contacto') %>"><%= t('footer.contacto') %></a>
    </div>

    <div class="footer-col">
      <h4><%= t('footer.contacto_titulo') %></h4>
      <a href="https://wa.me/34<%= empresa.whatsapp %>" target="_blank" rel="noopener"><%= empresa.whatsappDisplay %></a>
      <a href="mailto:<%= empresa.email %>"><%= empresa.email %></a>
      <span><%= empresa.zona %></span>
      <span><%= empresa.web %></span>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>&copy; <%= new Date().getFullYear() %> AHOMED. <%= t('footer.copyright') %></span>
      <div class="footer-legal-links">
        <a href="<%= pathHref('/aviso-legal') %>"><%= t('footer.aviso_legal') %></a>
        <a href="<%= pathHref('/privacidad') %>"><%= t('footer.privacidad') %></a>
        <a href="<%= pathHref('/cookies') %>"><%= t('footer.cookies') %></a>
      </div>
      <span><%= t('footer.disclaimer') %></span>
    </div>
  </div>
</footer>

