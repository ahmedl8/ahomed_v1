<meta name="description" content="<%= metaDescription %>" />
<link rel="canonical" href="https://<%= empresa.web %><%= langHref(lang) %>" />
<link rel="alternate" hreflang="es" href="https://<%= empresa.web %><%= langHref('es') %>" />
<link rel="alternate" hreflang="fr" href="https://<%= empresa.web %><%= langHref('fr') %>" />
<link rel="alternate" hreflang="en" href="https://<%= empresa.web %><%= langHref('en') %>" />
<link rel="alternate" hreflang="x-default" href="https://<%= empresa.web %><%= langHref('es') %>" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="<%= empresa.nombre %>" />
<meta property="og:title" content="<%= title %>" />
<meta property="og:description" content="<%= metaDescription %>" />
<meta property="og:image" content="https://<%= empresa.web %><%= typeof ogImage !== 'undefined' ? ogImage : '/img/hero-tecnico.jpg' %>" />
<meta property="og:url" content="https://<%= empresa.web %><%= langHref(lang) %>" />
<meta property="og:locale" content="<%= lang === 'fr' ? 'fr_FR' : (lang === 'en' ? 'en_US' : 'es_ES') %>" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" type="image/png" href="/img/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/style.min.css" />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "<%= empresa.nombre %>",
  "description": "<%= empresa.metaDescriptionDefault %>",
  "url": "https://<%= empresa.web %>",
  "telephone": "+34<%= empresa.whatsapp %>",
  "email": "<%= empresa.email %>",
  "areaServed": {
    "@type": "Place",
    "name": "<%= empresa.zona %>"
  },
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "Madrid",
    "addressCountry": "ES"
  },
  "priceRange": "€€"
}
</script>
