<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-item"><svg class="icon-sm" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg><%= empresa.zona %></span>
    <span class="topbar-item"><svg class="icon-sm" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 14l-4-4 1.41-1.41L11 12.17l6.59-6.59L19 7l-8 8z"/></svg>Más de <%= empresa.anosExperiencia %> de experiencia</span>
      <a class="topbar-item topbar-whatsapp" href="https://wa.me/34<%= empresa.whatsapp %>" target="_blank" rel="noopener">
        <svg class="icon-sm" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2zm0 18.15a8.13 8.13 0 0 1-4.146-1.135l-.297-.176-3.05.881.897-2.968-.193-.306A8.14 8.14 0 1 1 20.14 12a8.15 8.15 0 0 1-8.139 8.15z"/></svg>
        WhatsApp <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </div>

  <div class="container navbar">
    <a href="/" class="brand">
      <img src="/img/logo.png" alt="AHOMED — Soluciones integrales para el hogar" class="brand-logo" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <nav class="main-nav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Inicio</a>

      <% var basicosCols = function(b, audiencia) {
           var servs = services.filter(function(s){
             return s.bloque === b.slug && (s.publico === 'ambos' || s.publico === audiencia);
           });
           if (servs.length === 0) return;
      %>
        <div class="dropdown-col">
          <a href="/servicios/bloque/<%= b.slug %>" class="dropdown-col-title">
            <%= b.nombre %>
          </a>
          <% servs.forEach(function(s){ %>
            <a href="/servicios/<%= s.slug %>"><%= s.nombre %></a>
          <% }) %>
        </div>
      <% } %>

      <!-- PARA TU CASA -->
      <div class="nav-dropdown">
        <a href="/servicios" class="<%= currentPath.startsWith('/servicios') && currentPath !== '/servicios/mantenimiento' && currentPath !== '/servicios/bloque/seguridad-ia-naves-fincas' && !currentPath.startsWith('/servicios/naves-fincas') ? 'active' : '' %>">Para tu Casa ▾</a>
        <div class="dropdown-menu dropdown-menu-mega">
          <div class="dropdown-group dropdown-group-basico">
            <span class="dropdown-group-title">Básicos — sin IA</span>
            <div class="dropdown-group-cols">
              <% bloques.filter(function(b){ return b.grupo === 'basico'; }).forEach(function(b){ basicosCols(b, 'casa'); }) %>
            </div>
          </div>

          <div class="dropdown-group dropdown-group-exclusivo">
            <span class="dropdown-group-title">Con IA <em>(requiere el Mini-PC IA Central)</em></span>
            <div class="dropdown-group-cols">
              <div class="dropdown-col">
                <a href="/servicios/ia-predictiva" class="dropdown-col-title">
                  Plataforma IA Predictiva
                </a>
              </div>
            </div>
          </div>

          <div class="dropdown-group">
            <a href="/packs#packs-casa" class="dropdown-col-title">Ver packs para tu casa →</a>
          </div>
        </div>
      </div>

      <!-- NAVES Y FINCAS -->
      <div class="nav-dropdown">
        <a href="/servicios/bloque/seguridad-ia-naves-fincas" class="<%= currentPath === '/servicios/bloque/seguridad-ia-naves-fincas' || currentPath.startsWith('/servicios/naves-fincas') ? 'active' : '' %>">Naves y Fincas ▾</a>
        <div class="dropdown-menu dropdown-menu-mega">
          <div class="dropdown-group dropdown-group-basico">
            <span class="dropdown-group-title">Básicos — sin IA</span>
            <div class="dropdown-group-cols">
              <% bloques.filter(function(b){ return b.grupo === 'basico'; }).forEach(function(b){ basicosCols(b, 'negocio'); }) %>
            </div>
          </div>

          <div class="dropdown-group dropdown-group-exclusivo">
            <span class="dropdown-group-title">Con IA <em>(requiere el Mini-PC IA Central)</em></span>
            <div class="dropdown-group-cols">
              <div class="dropdown-col">
                <a href="/servicios/naves-fincas/seguridad-ia" class="dropdown-col-title">Seguridad IA</a>
              </div>
            </div>
          </div>

          <div class="dropdown-group">
            <a href="/packs#packs-negocio" class="dropdown-col-title">Ver packs para tu negocio →</a>
          </div>
        </div>
      </div>

      <a href="/packs" class="<%= currentPath === '/packs' ? 'active' : '' %>">Packs</a>
      <a href="/galeria" class="<%= currentPath === '/galeria' ? 'active' : '' %>">Galería</a>
      <a href="/servicios/mantenimiento" class="<%= currentPath === '/servicios/mantenimiento' ? 'active' : '' %>">Mantenimiento</a>
      <a href="/preguntas-frecuentes" class="<%= currentPath === '/preguntas-frecuentes' ? 'active' : '' %>">Preguntas frecuentes</a>
      <a href="/contacto" class="<%= currentPath === '/contacto' ? 'active' : '' %>">Contacto</a>
    </nav>

    <a href="https://wa.me/34<%= empresa.whatsapp %>?text=Hola%2C%20quiero%20pedir%20presupuesto" target="_blank" rel="noopener" class="btn btn-primary nav-cta">
      Pedir presupuesto
    </a>
  </div>
</header>
