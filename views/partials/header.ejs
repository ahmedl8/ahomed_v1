<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-item"><svg class="icon-sm" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg><%= empresa.zona %></span>
    <span class="topbar-item"><svg class="icon-sm" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 14l-4-4 1.41-1.41L11 12.17l6.59-6.59L19 7l-8 8z"/></svg><%= t('topbar.experience_prefix') %> <%= empresa.anosExperiencia %> <%= t('topbar.experience_suffix') %></span>
      <a class="topbar-item topbar-tel" href="tel:+34<%= empresa.whatsapp %>">
        <svg class="icon-sm" viewBox="0 0 24 24"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.4 11.4 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.58 1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
        <%= t('topbar.call') %>
      </a>
      <a class="topbar-item topbar-whatsapp" href="https://wa.me/34<%= empresa.whatsapp %>" target="_blank" rel="noopener">
        <svg class="icon-sm" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2zm0 18.15a8.13 8.13 0 0 1-4.146-1.135l-.297-.176-3.05.881.897-2.968-.193-.306A8.14 8.14 0 1 1 20.14 12a8.15 8.15 0 0 1-8.139 8.15z"/></svg>
        WhatsApp <%= empresa.whatsappDisplay %>
      </a>

      <div class="lang-switch">
        <button type="button" class="lang-switch-toggle" aria-haspopup="true" aria-expanded="false" aria-label="<%= t('lang.select') %>">
          <svg class="icon-sm" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.93 6h-2.95a15.6 15.6 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14a8.1 8.1 0 0 1 0-4h3.38a16.6 16.6 0 0 0 0 4H4.26zm.81 2h2.95c.33 1.28.8 2.48 1.38 3.56A8.03 8.03 0 0 1 5.07 16zm2.95-8H5.07a8.03 8.03 0 0 1 4.33-3.56A15.6 15.6 0 0 0 8.02 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66a14.6 14.6 0 0 1 0-4h4.68a14.6 14.6 0 0 1 0 4zm.25 5.56c.58-1.08 1.05-2.28 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56zM16.36 14a16.6 16.6 0 0 0 0-4h3.38a8.1 8.1 0 0 1 0 4h-3.38z"/></svg>
          <span class="lang-switch-current"><%= lang.toUpperCase() %></span>
        </button>
        <div class="lang-switch-menu">
          <a href="<%= langHref('es') %>" class="<%= lang === 'es' ? 'active' : '' %>">Español</a>
          <a href="<%= langHref('fr') %>" class="<%= lang === 'fr' ? 'active' : '' %>">Français</a>
          <a href="<%= langHref('en') %>" class="<%= lang === 'en' ? 'active' : '' %>">English</a>
        </div>
      </div>
    </div>
  </div>

  <div class="container navbar">
    <a href="<%= homeHref %>" class="brand">
      <img src="/img/logo.png" alt="<%= t('common.logo_alt') %>" class="brand-logo" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="<%= t('nav.open_menu') %>">
      <span></span><span></span><span></span>
    </label>

    <nav class="main-nav">
      <a href="<%= homeHref %>" class="<%= currentPath === '/' ? 'active' : '' %>"><%= t('nav.home') %></a>

      <!-- CONFIGURADOR / CREADOR -->
      <div class="nav-dropdown">
        <a href="<%= pathHref('/configurador') %>" class="<%= (currentPath === '/configurador' || currentPath === '/crea-tu-instalacion') ? 'active' : '' %>"><%= t('nav.configurador') %> ▾</a>
        <div class="dropdown-menu">
          <div class="dropdown-col">
            <a href="<%= pathHref('/configurador') %>" class="dropdown-col-title"><%= t('nav.configurador') %></a>
            <span class="dropdown-note"><%= t('nav.configurador_nota') %></span>
          </div>
          <div class="dropdown-col">
            <a href="<%= pathHref('/crea-tu-instalacion') %>" class="dropdown-col-title"><%= t('nav.crea_instalacion') %></a>
            <span class="dropdown-note"><%= t('nav.crea_instalacion_nota') %></span>
          </div>
        </div>
      </div>

      <% var basicosCols = function(b, audiencia) {
           var servs = services.filter(function(s){
             return s.bloque === b.slug && (s.publico === 'ambos' || s.publico === audiencia);
           });
           if (servs.length === 0) return;
      %>
        <div class="dropdown-col">
          <a href="<%= pathHref('/servicios/bloque/' + b.slug) %>" class="dropdown-col-title">
            <%= b.nombre %>
          </a>
          <ul class="dropdown-col-list">
            <% servs.forEach(function(s){ %>
              <li><a href="<%= pathHref('/servicios/' + s.slug) %>"><%= s.nombre %></a></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <!-- PARA TU CASA -->
      <div class="nav-dropdown">
        <a href="<%= pathHref('/servicios') %>" class="<%= currentPath.startsWith('/servicios') && currentPath !== '/servicios/mantenimiento' && currentPath !== '/servicios/bloque/seguridad-ia-naves-fincas' && !currentPath.startsWith('/servicios/naves-fincas') ? 'active' : '' %>"><%= t('nav.para_tu_casa') %> ▾</a>
        <div class="dropdown-menu dropdown-menu-mega">
          <div class="dropdown-group dropdown-group-basico">
            <span class="dropdown-group-title"><%= t('nav.instalaciones_servicios') %></span>
            <div class="dropdown-group-cols">
              <% bloques.filter(function(b){ return b.grupo === 'basico'; }).forEach(function(b){ basicosCols(b, 'casa'); }) %>
              <div class="dropdown-col">
                <a href="<%= pathHref('/servicios/bloque/mantenimiento') %>" class="dropdown-col-title"><%= t('nav.mantenimiento') %></a>
              </div>
            </div>
          </div>

          <div class="dropdown-group dropdown-group-exclusivo">
            <span class="dropdown-group-title"><%= t('nav.con_ia') %> <em><%= t('nav.con_ia_nota') %></em></span>
            <div class="dropdown-group-cols">
              <div class="dropdown-col">
                <a href="<%= pathHref('/servicios/ia-predictiva') %>" class="dropdown-col-title">
                  <%= t('nav.plataforma_ia') %>
                </a>
              </div>
            </div>
          </div>

          <div class="dropdown-group">
            <a href="<%= pathHref('/soluciones') %>#packs-casa" class="dropdown-col-title"><%= t('nav.ver_soluciones_casa') %></a>
            <span class="dropdown-note"><%= t('nav.combinaciones_nota') %></span>
          </div>
        </div>
      </div>

      <!-- NAVES Y FINCAS -->
      <div class="nav-dropdown">
        <a href="<%= pathHref('/servicios/bloque/seguridad-ia-naves-fincas') %>" class="<%= currentPath === '/servicios/bloque/seguridad-ia-naves-fincas' || currentPath.startsWith('/servicios/naves-fincas') ? 'active' : '' %>"><%= t('nav.naves_fincas') %> ▾</a>
        <div class="dropdown-menu dropdown-menu-mega">
          <div class="dropdown-group dropdown-group-basico">
            <span class="dropdown-group-title"><%= t('nav.instalaciones_servicios') %></span>
            <div class="dropdown-group-cols">
              <% bloques.filter(function(b){ return b.grupo === 'basico'; }).forEach(function(b){ basicosCols(b, 'negocio'); }) %>
            </div>
          </div>

          <div class="dropdown-group dropdown-group-exclusivo">
            <span class="dropdown-group-title"><%= t('nav.con_ia') %> <em><%= t('nav.con_ia_nota') %></em></span>
            <div class="dropdown-group-cols">
              <div class="dropdown-col">
                <a href="<%= pathHref('/servicios/naves-fincas/seguridad-ia') %>" class="dropdown-col-title"><%= t('nav.seguridad_ia') %></a>
              </div>
            </div>
          </div>

          <div class="dropdown-group">
            <a href="<%= pathHref('/soluciones') %>#packs-negocio" class="dropdown-col-title"><%= t('nav.ver_soluciones_negocio') %></a>
            <span class="dropdown-note"><%= t('nav.combinaciones_nota') %></span>
          </div>
        </div>
      </div>

      <a href="<%= pathHref('/soluciones') %>" class="<%= currentPath === '/soluciones' ? 'active' : '' %>"><%= t('nav.soluciones') %></a>
      <a href="<%= pathHref('/para-profesionales') %>" class="<%= currentPath === '/para-profesionales' ? 'active' : '' %>"><%= t('nav.para_profesionales') %></a>
      <a href="<%= pathHref('/preguntas-frecuentes') %>" class="<%= currentPath === '/preguntas-frecuentes' ? 'active' : '' %>"><%= t('nav.faq') %></a>
      <a href="<%= pathHref('/contacto') %>" class="<%= currentPath === '/contacto' ? 'active' : '' %>"><%= t('nav.contacto') %></a>

      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('common.whatsapp_text_presupuesto') %>" target="_blank" rel="noopener" class="btn btn-whatsapp mobile-nav-cta">
        <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.502 3.657 1.454 5.235L2 22l4.897-1.415A9.955 9.955 0 0 0 12.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2zm0 18.15a8.13 8.13 0 0 1-4.146-1.135l-.297-.176-3.05.881.897-2.968-.193-.306A8.14 8.14 0 1 1 20.14 12a8.15 8.15 0 0 1-8.139 8.15z"/></svg>
        <%= t('nav.pedir_presupuesto_whatsapp') %>
      </a>
    </nav>

    <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('common.whatsapp_text_presupuesto') %>" target="_blank" rel="noopener" class="btn btn-primary nav-cta">
      <%= t('nav.pedir_presupuesto') %>
    </a>
  </div>
</header>
