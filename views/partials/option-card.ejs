<%# Partial: renders one option-card with total always visible and the
    line-item breakdown collapsed behind a native <details> toggle.
    Expects local var `op` = { nombre, destacada, items: [[label, price], ...], total, totalUnidad }
    Optional local var `ctaHtml` = raw HTML string for a CTA rendered inside the card, below the price. %>
<div class="option-card <%= op.destacada ? 'option-card-featured' : '' %>">
  <% if (op.destacada) { %><span class="option-star">⭐ Inteligente</span><% } %>
  <h3><%= op.nombre %></h3>
  <p class="option-total-headline"><%= fmt(op.total) %> <%= op.totalUnidad || '€' %></p>
  <details class="option-breakdown">
    <summary>Ver desglose</summary>
    <table class="option-table">
      <tbody>
        <% op.items.forEach(function(item){ %>
          <tr>
            <td><%= item[0] %></td>
            <td class="option-price"><%= fmt(item[1]) %> €</td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td>TOTAL</td>
          <td class="option-price option-total"><%= fmt(op.total) %> <%= op.totalUnidad || '€' %></td>
        </tr>
      </tfoot>
    </table>
  </details>
  <% if (typeof ctaHtml !== 'undefined' && ctaHtml) { %><%- ctaHtml %><% } %>
</div>
