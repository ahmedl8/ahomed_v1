<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/gtm-body') %>
  <%- include('../partials/header') %>

  <section class="service-hero<%= service.heroImagen ? ' service-hero-photo' : '' %>">
    <% if (service.heroImagen) { %>
      <img class="service-hero-bg" src="<%= service.heroImagen %>" alt="" loading="eager">
      <div class="service-hero-overlay"></div>
    <% } %>
    <div class="container service-hero-inner">
      <div class="service-hero-icon"><svg viewBox="0 0 24 24"><%- icons[service.icono] %></svg></div>
      <div>
        <% if (bloque) { %>
          <nav class="breadcrumb" aria-label="<%= t('detalle_servicio.breadcrumb.aria') %>">
            <a href="/servicios"><%= t('nav.servicios') %></a> ›
            <a href="/servicios/bloque/<%= bloque.slug %>"><%= bloque.nombre %></a>
          </nav>
        <% } %>
        <span class="eyebrow"><%= tv('detalle_servicio.eyebrow', { numero: service.numero }) %></span>
        <h1><%= service.nombre %></h1>
        <p><%= service.resumen %></p>
        <% if (service.versionAlternativa) { %>
          <p class="service-version-alt">
            <%= service.publico === 'negocio' ? t('detalle_servicio.version_alt.pregunta_vivienda') : t('detalle_servicio.version_alt.pregunta_nave') %>
            <a href="/servicios/<%= service.versionAlternativa %>"><%= service.publico === 'negocio' ? t('detalle_servicio.version_alt.link_casa') : t('detalle_servicio.version_alt.link_naves') %></a>
          </p>
        <% } %>
        <div class="service-meta">
          <span class="meta-chip"><%= service.tiempo %></span>
          <span class="meta-chip meta-chip-price"><%= tv('detalle_servicio.desde_precio', { precio: fmt(service.desde), unidad: service.desdeUnidad || '' }) %></span>
        </div>
      </div>
    </div>
  </section>

  <% if (service.avisoUrgente) { %>
    <section class="section section-urgent">
      <div class="container">
        <div class="urgent-callout">
          <div class="urgent-callout-icon"><svg viewBox="0 0 24 24"><%- icons[service.icono] %></svg></div>
          <div class="urgent-callout-body">
            <p class="urgent-callout-title"><%= service.avisoUrgente.titulo %></p>
            <p class="urgent-callout-texto"><%= service.avisoUrgente.texto %></p>
          </div>
          <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent(service.avisoUrgente.mensajeWhatsapp) %>" target="_blank" rel="noopener" class="btn btn-whatsapp urgent-callout-cta">
            <%= service.avisoUrgente.ctaTexto %>
          </a>
        </div>
      </div>
    </section>
  <% } %>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2 class="sub-heading"><%= t('detalle_servicio.ideal_para.title') %></h2>
        <ul class="check-list check-list-lg">
          <% service.idealPara.forEach(function(item){ %>
            <li><%= item %></li>
          <% }) %>
        </ul>

        <% if (service.extras && service.extras.length) { %>
          <h2 class="sub-heading"><%= t('detalle_servicio.extras.title') %></h2>
          <ul class="plus-list">
            <% service.extras.forEach(function(item){ %>
              <li><%= item %></li>
            <% }) %>
          </ul>
        <% } %>

        <% if (service.tambienInstalaron && service.tambienInstalaron.length) { %>
          <h2 class="sub-heading"><%= t('detalle_servicio.tambien_instalaron.title') %></h2>
          <ul class="dot-list dot-list-links">
            <% service.tambienInstalaron.forEach(function(item){ %>
              <% if (item.href) { %>
                <li><a href="<%= item.href %>"><%= item.texto %></a></li>
              <% } else { %>
                <li><%= item.texto %></li>
              <% } %>
            <% }) %>
          </ul>
        <% } %>

        <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent(tv('detalle_servicio.whatsapp_presupuesto', { servicio: service.nombre.toLowerCase() })) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg cta-block">
          <%= t('detalle_servicio.cta_presupuesto') %>
        </a>
      </div>

      <% var allExamples = [service.ejemplo].concat(service.ejemplosAdicionales || []); %>
      <div class="example-panel">
        <% if (allExamples.length > 1) { %>
          <div class="example-tabs">
            <% allExamples.forEach(function(ex, i){ %>
              <input type="radio" name="example-tab-<%= service.slug %>" id="example-tab-<%= service.slug %>-<%= i %>" class="example-tab-input" <%= i === 0 ? 'checked' : '' %>>
            <% }) %>

            <div class="example-tab-nav">
              <% allExamples.forEach(function(ex, i){ %>
                <label for="example-tab-<%= service.slug %>-<%= i %>" class="example-tab-btn"><%= ex.titulo %></label>
              <% }) %>
            </div>

            <div class="example-tab-panels">
              <% allExamples.forEach(function(ex, i){ %>
                <div class="example-tab-panel" id="panel-<%= service.slug %>-<%= i %>">
                  <h2 class="sub-heading"><%= tv('detalle_servicio.ejemplo_real.title', { titulo: ex.titulo }) %></h2>
                  <% if (ex.cliente) { %><p class="example-client"><%= ex.cliente %></p><% } %>

                  <% if (ex.imagen && ex.imagenAntes) { %>
                    <div class="pack-photo-pair">
                      <div class="pack-photo-wrap">
                        <span class="photo-label"><%= t('detalle_servicio.antes') %></span>
                        <img src="<%= ex.imagenAntes %>" alt="<%= tv('detalle_servicio.antes_alt', { titulo: ex.titulo }) %>" loading="lazy">
                      </div>
                      <div class="pack-photo-wrap">
                        <span class="photo-label photo-label-after"><%= t('detalle_servicio.despues') %></span>
                        <img src="<%= ex.imagen %>" alt="<%= tv('detalle_servicio.despues_alt', { titulo: ex.titulo }) %>" loading="lazy">
                      </div>
                    </div>
                  <% } else if (ex.imagen) { %>
                    <div class="pack-photo-single">
                      <img src="<%= ex.imagen %>" alt="<%= ex.titulo %>" loading="lazy">
                    </div>
                  <% } %>

                  <div class="options-stack">
                    <% ex.opciones.forEach(function(op){ %>
                      <%- include('../partials/option-card', { op: op, fmt: fmt, serviceNombre: service.nombre, empresa: empresa }) %>
                    <% }) %>
                  </div>

                  <% if (ex.nota) { %>
                    <p class="example-note"><%= ex.nota %></p>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <h2 class="sub-heading"><%= tv('detalle_servicio.ejemplo_real.title', { titulo: service.ejemplo.titulo }) %></h2>
          <% if (service.ejemplo.cliente) { %><p class="example-client"><%= service.ejemplo.cliente %></p><% } %>

          <% if (service.ejemplo.imagen && service.ejemplo.imagenAntes) { %>
            <div class="pack-photo-pair">
              <div class="pack-photo-wrap">
                <span class="photo-label"><%= t('detalle_servicio.antes') %></span>
                <img src="<%= service.ejemplo.imagenAntes %>" alt="<%= tv('detalle_servicio.antes_alt', { titulo: service.ejemplo.titulo }) %>" loading="lazy">
              </div>
              <div class="pack-photo-wrap">
                <span class="photo-label photo-label-after"><%= t('detalle_servicio.despues') %></span>
                <img src="<%= service.ejemplo.imagen %>" alt="<%= tv('detalle_servicio.despues_alt', { titulo: service.ejemplo.titulo }) %>" loading="lazy">
              </div>
            </div>
          <% } else if (service.ejemplo.imagen) { %>
            <div class="pack-photo-single">
              <img src="<%= service.ejemplo.imagen %>" alt="<%= service.ejemplo.titulo %>" loading="lazy">
            </div>
          <% } %>

          <div class="options-stack">
            <% service.ejemplo.opciones.forEach(function(op){ %>
              <%- include('../partials/option-card', { op: op, fmt: fmt, serviceNombre: service.nombre, empresa: empresa }) %>
            <% }) %>
          </div>

          <% if (service.ejemplo.nota) { %>
            <p class="example-note"><%= service.ejemplo.nota %></p>
          <% } %>
        <% } %>

        <p class="orientative-note"><%= t('detalle_servicio.nota_orientativa') %></p>
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= tv('detalle_servicio.cta_final.title', { servicio: service.nombre.toLowerCase() }) %></h2>
      <p><%= t('detalle_servicio.cta_final.subtitle') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent(tv('detalle_servicio.whatsapp_presupuesto', { servicio: service.nombre.toLowerCase() })) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
