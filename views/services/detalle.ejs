<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/gtm-body') %>
  <%- include('../partials/header') %>

  <section class="service-hero<%= service.heroImagen ? ' service-hero-photo' : '' %>">
    <% if (service.heroImagen) { %>
      <img class="service-hero-bg" src="<%= service.heroImagen %>" alt="" loading="eager"<% if (service.heroPosicion) { %> style="object-position: <%= service.heroPosicion %>"<% } %>>
      <div class="service-hero-overlay"></div>
    <% } %>
    <div class="container service-hero-inner">
      <div class="service-hero-icon"><svg viewBox="0 0 24 24"><%- icons[service.icono] %></svg></div>
      <div>
        <nav class="breadcrumb" aria-label="<%= t('detalle_servicio.breadcrumb.aria') %>">
          <a href="<%= pathHref('/servicios') %>"><%= t('nav.servicios') %></a>
        </nav>
        <% if (familia) { %>
          <a class="eyebrow eyebrow-link" href="<%= pathHref('/servicios#' + familia.slug) %>"><%= familia.nombre %></a>
        <% } %>
        <h1><%= service.nombre %></h1>
        <p><%= service.resumen %></p>
        <div class="service-meta">
          <span class="meta-chip"><%= service.tiempo %></span>
          <span class="meta-chip meta-chip-free"><%= t('detalle_servicio.visita_gratis') %></span>
        </div>
      </div>
    </div>
  </section>

  <% if (service.avisoUrgente) { %>
    <section class="section section-urgent">
      <div class="container">
        <div class="urgent-callout">
          <div class="urgent-callout-icon"><svg viewBox="0 0 24 24"><%- icons[service.icono] %></svg></div>
          <div class="urgent-callout-body">
            <p class="urgent-callout-title"><%= service.avisoUrgente.titulo %></p>
            <p class="urgent-callout-texto"><%= service.avisoUrgente.texto %></p>
          </div>
          <div class="urgent-callout-actions">
            <a href="tel:+34<%= empresa.whatsapp %>" class="btn btn-primary urgent-callout-cta" data-gtm-event="clic_llamada" data-lugar="urgente" data-servicio="<%= service.nombre %>">
              <%= tv('visita.llamar', { tel: empresa.whatsappDisplay }) %>
            </a>
            <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent(service.avisoUrgente.mensajeWhatsapp) %>" target="_blank" rel="noopener" class="btn btn-whatsapp urgent-callout-cta" data-gtm-event="clic_whatsapp_visita" data-lugar="urgente" data-servicio="<%= service.nombre %>">
              <%= service.avisoUrgente.ctaTexto %>
            </a>
          </div>
        </div>
      </div>
    </section>
  <% } %>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2 class="sub-heading"><%= t('detalle_servicio.ideal_para.title') %></h2>
        <ul class="check-list check-list-lg">
          <% service.idealPara.forEach(function(item){ %>
            <li><%= item %></li>
          <% }) %>
        </ul>

        <% if (service.extras && service.extras.length) { %>
          <h2 class="sub-heading"><%= t('detalle_servicio.extras.title') %></h2>
          <ul class="plus-list">
            <% service.extras.forEach(function(item){ %>
              <li><%= item %></li>
            <% }) %>
          </ul>
        <% } %>

        <% if (service.tambienInstalaron && service.tambienInstalaron.length) { %>
          <h2 class="sub-heading"><%= t('detalle_servicio.tambien_instalaron.title') %></h2>
          <ul class="dot-list dot-list-links">
            <% service.tambienInstalaron.forEach(function(item){ %>
              <% if (item.href) { %>
                <li><a href="<%= pathHref(item.href) %>"><%= item.texto %></a></li>
              <% } else { %>
                <li><%= item.texto %></li>
              <% } %>
            <% }) %>
          </ul>
        <% } %>

        <div class="cta-pair">
          <a href="tel:+34<%= empresa.whatsapp %>" class="btn btn-primary btn-lg" data-gtm-event="clic_llamada" data-lugar="ficha" data-servicio="<%= service.nombre %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.4 11.4 0 0 0 3.58.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.58 1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg>
            <%= tv('visita.llamar', { tel: empresa.whatsappDisplay }) %>
          </a>
          <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent(tv('detalle_servicio.whatsapp_presupuesto', { servicio: service.nombre.toLowerCase() })) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg" data-gtm-event="clic_whatsapp_visita" data-lugar="ficha" data-servicio="<%= service.nombre %>">
            <%= t('detalle_servicio.cta_presupuesto') %>
          </a>
        </div>
        <p class="cta-pair-note"><%= t('visita.nota') %></p>
      </div>

      <% var allExamples = [service.ejemplo].concat(service.ejemplosAdicionales || []); %>
      <div class="example-panel">
        <% if (allExamples.length > 1) { %>
          <div class="example-tabs">
            <% allExamples.forEach(function(ex, i){ %>
              <input type="radio" name="example-tab-<%= service.slug %>" id="example-tab-<%= service.slug %>-<%= i %>" class="example-tab-input" <%= i === 0 ? 'checked' : '' %>>
            <% }) %>

            <div class="example-tab-nav">
              <% allExamples.forEach(function(ex, i){ %>
                <label for="example-tab-<%= service.slug %>-<%= i %>" class="example-tab-btn"><%= ex.titulo %></label>
              <% }) %>
            </div>

            <div class="example-tab-panels">
              <% allExamples.forEach(function(ex, i){ %>
                <div class="example-tab-panel" id="panel-<%= service.slug %>-<%= i %>">
                  <h2 class="sub-heading"><%= tv('detalle_servicio.ejemplo_real.title', { titulo: ex.titulo }) %></h2>
                  <% if (ex.cliente) { %><p class="example-client"><%= ex.cliente %></p><% } %>

                  <%- include('../partials/example-photos', { ex: ex, t: t, tv: tv, empresa: empresa }) %>

                  <%- include('../partials/example-includes', { ex: ex, t: t }) %>
                </div>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <h2 class="sub-heading"><%= tv('detalle_servicio.ejemplo_real.title', { titulo: service.ejemplo.titulo }) %></h2>
          <% if (service.ejemplo.cliente) { %><p class="example-client"><%= service.ejemplo.cliente %></p><% } %>

          <%- include('../partials/example-photos', { ex: service.ejemplo, t: t, tv: tv, empresa: empresa }) %>

          <%- include('../partials/example-includes', { ex: service.ejemplo, t: t }) %>
        <% } %>

        <p class="orientative-note"><%= t('detalle_servicio.nota_visita') %></p>
      </div>
    </div>
  </section>

  <% if (service.slug === 'reformas-parciales' || service.slug === 'reforma-integral') { %>
    <%- include('../partials/reforma-cta', { t: t, empresa: empresa, pathHref: pathHref, services: services, conEnlaces: false }) %>
  <% } %>

  <%- include('../partials/garantia-colaboradores', { t: t, tv: tv, empresa: empresa, icons: icons, pathHref: pathHref }) %>

  <%- include('../partials/cta-visita', { t: t, tv: tv, empresa: empresa, servicio: service.nombre, lugar: 'ficha-final' }) %>

  <%- include('../partials/footer') %>
</body>
</html>
