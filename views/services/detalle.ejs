<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <section class="service-hero<%= service.heroImagen ? ' service-hero-photo' : '' %>">
    <% if (service.heroImagen) { %>
      <img class="service-hero-bg" src="<%= service.heroImagen %>" alt="" loading="eager">
      <div class="service-hero-overlay"></div>
    <% } %>
    <div class="container service-hero-inner">
      <div class="service-hero-icon"><svg viewBox="0 0 24 24"><%- icons[service.icono] %></svg></div>
      <div>
        <% if (bloque) { %>
          <nav class="breadcrumb" aria-label="Ruta de navegación">
            <a href="/servicios">Servicios</a> ›
            <a href="/servicios/bloque/<%= bloque.slug %>"><%= bloque.nombre %></a>
          </nav>
        <% } %>
        <span class="eyebrow">Servicio <%= service.numero %></span>
        <h1><%= service.nombre %></h1>
        <p><%= service.resumen %></p>
        <div class="service-meta">
          <span class="meta-chip"><%= service.tiempo %></span>
          <span class="meta-chip meta-chip-price">Desde <%= fmt(service.desde) %> €<%= service.desdeUnidad || '' %></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2 class="sub-heading">Ideal para</h2>
        <ul class="check-list check-list-lg">
          <% service.idealPara.forEach(function(item){ %>
            <li><%= item %></li>
          <% }) %>
        </ul>

        <% if (service.extras && service.extras.length) { %>
          <h2 class="sub-heading">Extras habituales</h2>
          <ul class="plus-list">
            <% service.extras.forEach(function(item){ %>
              <li><%= item %></li>
            <% }) %>
          </ul>
        <% } %>

        <% if (service.tambienInstalaron && service.tambienInstalaron.length) { %>
          <h2 class="sub-heading">Clientes que contrataron este servicio también instalaron</h2>
          <ul class="dot-list">
            <% service.tambienInstalaron.forEach(function(item){ %>
              <li><%= item %></li>
            <% }) %>
          </ul>
        <% } %>

        <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent('Hola, quiero pedir presupuesto para ' + service.nombre.toLowerCase()) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg cta-block">
          Pedir presupuesto gratuito
        </a>
      </div>

      <% var allExamples = [service.ejemplo].concat(service.ejemplosAdicionales || []); %>
      <div class="example-panel">
        <% if (allExamples.length > 1) { %>
          <div class="example-tabs">
            <% allExamples.forEach(function(ex, i){ %>
              <input type="radio" name="example-tab-<%= service.slug %>" id="example-tab-<%= service.slug %>-<%= i %>" class="example-tab-input" <%= i === 0 ? 'checked' : '' %>>
            <% }) %>

            <div class="example-tab-nav">
              <% allExamples.forEach(function(ex, i){ %>
                <label for="example-tab-<%= service.slug %>-<%= i %>" class="example-tab-btn"><%= ex.titulo %></label>
              <% }) %>
            </div>

            <div class="example-tab-panels">
              <% allExamples.forEach(function(ex, i){ %>
                <div class="example-tab-panel" id="panel-<%= service.slug %>-<%= i %>">
                  <h2 class="sub-heading">Ejemplo real — <%= ex.titulo %></h2>
                  <% if (ex.cliente) { %><p class="example-client"><%= ex.cliente %></p><% } %>

                  <% if (ex.imagen && ex.imagenAntes) { %>
                    <div class="pack-photo-pair">
                      <div class="pack-photo-wrap">
                        <span class="photo-label">Antes</span>
                        <img src="<%= ex.imagenAntes %>" alt="Antes — <%= ex.titulo %>" loading="lazy">
                      </div>
                      <div class="pack-photo-wrap">
                        <span class="photo-label photo-label-after">Después</span>
                        <img src="<%= ex.imagen %>" alt="Después — <%= ex.titulo %>" loading="lazy">
                      </div>
                    </div>
                  <% } else if (ex.imagen) { %>
                    <div class="pack-photo-single">
                      <img src="<%= ex.imagen %>" alt="<%= ex.titulo %>" loading="lazy">
                    </div>
                  <% } %>

                  <div class="options-stack">
                    <% ex.opciones.forEach(function(op){ %>
                      <div class="option-card <%= op.destacada ? 'option-card-featured' : '' %>">
                        <% if (op.destacada) { %><span class="option-star">⭐ Inteligente</span><% } %>
                        <h3><%= op.nombre %></h3>
                        <table class="option-table">
                          <tbody>
                            <% op.items.forEach(function(item){ %>
                              <tr>
                                <td><%= item[0] %></td>
                                <td class="option-price"><%= fmt(item[1]) %> €</td>
                              </tr>
                            <% }) %>
                          </tbody>
                          <tfoot>
                            <tr>
                              <td>TOTAL</td>
                              <td class="option-price option-total"><%= fmt(op.total) %> <%= op.totalUnidad || '€' %></td>
                            </tr>
                          </tfoot>
                        </table>
                      </div>
                    <% }) %>
                  </div>

                  <% if (ex.nota) { %>
                    <p class="example-note"><%= ex.nota %></p>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <h2 class="sub-heading">Ejemplo real — <%= service.ejemplo.titulo %></h2>
          <% if (service.ejemplo.cliente) { %><p class="example-client"><%= service.ejemplo.cliente %></p><% } %>

          <% if (service.ejemplo.imagen && service.ejemplo.imagenAntes) { %>
            <div class="pack-photo-pair">
              <div class="pack-photo-wrap">
                <span class="photo-label">Antes</span>
                <img src="<%= service.ejemplo.imagenAntes %>" alt="Antes — <%= service.ejemplo.titulo %>" loading="lazy">
              </div>
              <div class="pack-photo-wrap">
                <span class="photo-label photo-label-after">Después</span>
                <img src="<%= service.ejemplo.imagen %>" alt="Después — <%= service.ejemplo.titulo %>" loading="lazy">
              </div>
            </div>
          <% } else if (service.ejemplo.imagen) { %>
            <div class="pack-photo-single">
              <img src="<%= service.ejemplo.imagen %>" alt="<%= service.ejemplo.titulo %>" loading="lazy">
            </div>
          <% } %>

          <div class="options-stack">
            <% service.ejemplo.opciones.forEach(function(op){ %>
              <div class="option-card <%= op.destacada ? 'option-card-featured' : '' %>">
                <% if (op.destacada) { %><span class="option-star">⭐ Inteligente</span><% } %>
                <h3><%= op.nombre %></h3>
                <table class="option-table">
                  <tbody>
                    <% op.items.forEach(function(item){ %>
                      <tr>
                        <td><%= item[0] %></td>
                        <td class="option-price"><%= fmt(item[1]) %> €</td>
                      </tr>
                    <% }) %>
                  </tbody>
                  <tfoot>
                    <tr>
                      <td>TOTAL</td>
                      <td class="option-price option-total"><%= fmt(op.total) %> <%= op.totalUnidad || '€' %></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            <% }) %>
          </div>

          <% if (service.ejemplo.nota) { %>
            <p class="example-note"><%= service.ejemplo.nota %></p>
          <% } %>
        <% } %>

        <p class="orientative-note">Todos los importes son orientativos. El precio definitivo se confirma tras la visita técnica gratuita.</p>
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2>¿Empezamos con tu <%= service.nombre.toLowerCase() %>?</h2>
      <p>Primera visita gratuita. Presupuesto sin compromiso.</p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent('Hola, quiero pedir presupuesto para ' + service.nombre.toLowerCase()) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
