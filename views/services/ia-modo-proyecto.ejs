<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/gtm-body') %>
  <%- include('../partials/header') %>

  <section class="service-hero service-hero-ai service-hero-photo">
    <img class="service-hero-bg" src="<%= modo.imagen %>" alt="" loading="eager">
    <div class="service-hero-overlay"></div>
    <div class="container service-hero-inner">
      <div class="service-hero-icon"><svg viewBox="0 0 24 24"><%- icons[modo.icono] %></svg></div>
      <div>
        <nav class="breadcrumb" aria-label="<%= t('detalle_servicio.breadcrumb.aria') %>">
          <a href="/servicios"><%= t('nav.servicios') %></a> ›
          <a href="/servicios/ia-predictiva"><%= t('nav.plataforma_ia') %></a>
        </nav>
        <span class="eyebrow"><%= tv('ia_modo.eyebrow', { numero: modo.numero, total: totalModos }) %> — <%= modo.subtitulo %></span>
        <% if (modo.titular) { %><p class="hero-titular"><%= modo.titular %></p><% } %>
        <h1><%= modo.nombre %></h1>
        <p><%= modo.resumen %></p>
        <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('ia_modo_proyecto.whatsapp_text_hero') %>" target="_blank" rel="noopener" class="btn btn-whatsapp cta-block">
          <%= t('detalle_servicio.cta_presupuesto') %>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="ia-modo-info-box">
        <p><strong><%= t('ia_modo.requiere_minipc.title') %></strong></p>
        <p><%- t('ia_modo_proyecto.requiere_minipc_text') %></p>
      </div>

      <% if (modo.video) { %>
        <div class="modo-video-wrap">
          <video class="modo-video" controls preload="none" poster="<%= modo.imagen %>">
            <source src="<%= modo.video %>" type="video/mp4">
          </video>
        </div>
      <% } %>

      <% modo.ejemplos.forEach(function(ej, idx){ %>
        <div class="ia-example-block">
          <h2 class="sub-heading"><%= tv('detalle_servicio.ejemplo_real.title', { titulo: ej.titulo }) %></h2>
          <p class="example-client"><%= ej.subtitulo %></p>

          <% if (ej.imagen && ej.imagenAntes) { %>
            <div class="pack-photo-pair">
              <div class="pack-photo-wrap">
                <span class="photo-label"><%= t('detalle_servicio.antes') %></span>
                <img src="<%= ej.imagenAntes %>" alt="<%= tv('detalle_servicio.antes_alt', { titulo: ej.titulo }) %>" loading="lazy">
              </div>
              <div class="pack-photo-wrap">
                <span class="photo-label photo-label-after"><%= t('detalle_servicio.despues') %></span>
                <img src="<%= ej.imagen %>" alt="<%= tv('detalle_servicio.despues_alt', { titulo: ej.titulo }) %>" loading="lazy">
              </div>
            </div>
          <% } %>

          <div class="options-stack options-stack-3">
            <% ej.opciones.forEach(function(op){ %>
              <%- include('../partials/option-card', { op: op, fmt: fmt, serviceNombre: modo.nombre, empresa: empresa }) %>
            <% }) %>
          </div>
        </div>
      <% }) %>

      <% if (modo.nota) { %><p class="example-note"><%= modo.nota %></p><% } %>

      <div class="two-col two-col-top">
        <div>
          <h2 class="sub-heading"><%= t('detalle_servicio.extras.title') %></h2>
          <ul class="plus-list">
            <% modo.extras.forEach(function(item){ %>
              <li><%= item %></li>
            <% }) %>
          </ul>
        </div>
        <div>
          <h2 class="sub-heading"><%= t('detalle_servicio.tambien_instalaron.title') %></h2>
          <ul class="dot-list dot-list-links">
            <% modo.tambienInstalaron.forEach(function(item){ %>
              <% if (item.href) { %>
                <li><a href="<%= item.href %>"><%= item.texto %></a></li>
              <% } else { %>
                <li><%= item.texto %></li>
              <% } %>
            <% }) %>
          </ul>
        </div>
      </div>

      <p class="orientative-note"><%= t('detalle_servicio.nota_orientativa') %></p>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('ia_modo_proyecto.cta_final.title') %></h2>
      <p><%= t('detalle_servicio.cta_final.subtitle') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('ia_modo_proyecto.whatsapp_text_hero') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
