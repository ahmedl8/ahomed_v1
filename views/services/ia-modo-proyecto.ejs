<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <section class="service-hero service-hero-ai service-hero-photo">
    <img class="service-hero-bg" src="<%= modo.imagen %>" alt="" loading="eager">
    <div class="service-hero-overlay"></div>
    <div class="container service-hero-inner">
      <div class="service-hero-icon"><svg viewBox="0 0 24 24"><%- icons[modo.icono] %></svg></div>
      <div>
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <a href="/servicios">Servicios</a> ›
          <a href="/servicios/ia-predictiva">Plataforma IA Predictiva</a>
        </nav>
        <span class="eyebrow">Modo 10 de 10 — <%= modo.subtitulo %></span>
        <% if (modo.titular) { %><p class="hero-titular"><%= modo.titular %></p><% } %>
        <h1><%= modo.nombre %></h1>
        <p><%= modo.resumen %></p>
        <a href="https://wa.me/34<%= empresa.whatsapp %>?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20Seguridad%20IA" target="_blank" rel="noopener" class="btn btn-whatsapp cta-block">
          Pedir presupuesto gratuito
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="ia-modo-info-box">
        <p><strong>Requiere el Mini-PC IA Central</strong></p>
        <p>Seguridad IA es el modo 10 de la Plataforma IA Predictiva: reutiliza el mismo <a href="/servicios/ia-predictiva">Mini-PC IA Central (950 €, obligatorio)</a> que el resto de modos — no necesitas comprar un mini-PC de grabación aparte. Los precios de abajo son el coste de las cámaras, la configuración del modelo de detección y la puesta en marcha.</p>
      </div>

      <% modo.ejemplos.forEach(function(ej, idx){ %>
        <div class="ia-example-block">
          <h2 class="sub-heading">Ejemplo — <%= ej.titulo %></h2>
          <p class="example-client"><%= ej.subtitulo %></p>

          <% if (ej.imagen && ej.imagenAntes) { %>
            <div class="pack-photo-pair">
              <div class="pack-photo-wrap">
                <span class="photo-label">Antes</span>
                <img src="<%= ej.imagenAntes %>" alt="Antes — <%= ej.titulo %>" loading="lazy">
              </div>
              <div class="pack-photo-wrap">
                <span class="photo-label photo-label-after">Después</span>
                <img src="<%= ej.imagen %>" alt="Después — <%= ej.titulo %>" loading="lazy">
              </div>
            </div>
          <% } %>

          <div class="options-stack options-stack-3">
            <% ej.opciones.forEach(function(op){ %>
              <%- include('../partials/option-card', { op: op, fmt: fmt }) %>
            <% }) %>
          </div>
        </div>
      <% }) %>

      <% if (modo.nota) { %><p class="example-note"><%= modo.nota %></p><% } %>

      <div class="two-col two-col-top">
        <div>
          <h2 class="sub-heading">Extras habituales</h2>
          <ul class="plus-list">
            <% modo.extras.forEach(function(item){ %>
              <li><%= item %></li>
            <% }) %>
          </ul>
        </div>
        <div>
          <h2 class="sub-heading">Clientes que contrataron este servicio también instalaron</h2>
          <ul class="dot-list">
            <% modo.tambienInstalaron.forEach(function(item){ %>
              <li><%= item %></li>
            <% }) %>
          </ul>
        </div>
      </div>

      <p class="orientative-note">Todos los importes son orientativos. El precio definitivo se confirma tras la visita técnica gratuita.</p>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2>¿Hablamos de tu proyecto de vigilancia inteligente?</h2>
      <p>Primera visita gratuita. Presupuesto sin compromiso.</p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20Seguridad%20IA" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
