<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/gtm-body') %>
  <%- include('../partials/header') %>

  <section class="service-hero service-hero-ai<%= modo.imagen ? ' service-hero-photo' : '' %>">
    <% if (modo.imagen) { %>
      <img class="service-hero-bg" src="<%= modo.imagen %>" alt="" loading="eager">
      <div class="service-hero-overlay"></div>
    <% } %>
    <div class="container service-hero-inner">
      <div class="service-hero-icon"><svg viewBox="0 0 24 24"><%- icons[modo.icono] %></svg></div>
      <div>
        <nav class="breadcrumb" aria-label="<%= t('detalle_servicio.breadcrumb.aria') %>">
          <a href="/servicios"><%= t('nav.servicios') %></a> ›
          <a href="/servicios/ia-predictiva"><%= t('nav.plataforma_ia') %></a>
        </nav>
        <span class="eyebrow"><%= tv('ia_modo.eyebrow', { numero: modo.numero, total: totalModos }) %> — <%= modo.subtitulo %></span>
        <% if (modo.titular) { %><p class="hero-titular"><%= modo.titular %></p><% } %>
        <h1><%= modo.nombre %></h1>
        <p><%= modo.resumen %></p>
        <div class="service-meta">
          <span class="meta-chip meta-chip-price"><%= tv('ia_modo.precio_sobre_minipc', { precio: fmt(modo.precioIncremento) }) %></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2 class="sub-heading"><%= t('detalle_servicio.ideal_para.title') %></h2>
        <ul class="check-list check-list-lg">
          <% modo.idealPara.forEach(function(item){ %>
            <li><%= item %></li>
          <% }) %>
        </ul>

        <div class="ia-modo-info-box">
          <p><strong><%= t('ia_modo.requiere_minipc.title') %></strong></p>
          <p><%- tv('ia_modo.requiere_minipc.text', { precio: fmt(modo.precioIncremento) }) %></p>
        </div>

        <% if (modo.video) { %>
          <div class="modo-video-wrap">
            <video class="modo-video" controls preload="none" poster="<%= modo.imagen %>">
              <source src="<%= modo.video %>" type="video/mp4">
            </video>
          </div>
        <% } %>

        <% if (modo.videosExtra && modo.videosExtra.length) { %>
          <div class="video-extra-grid">
            <% modo.videosExtra.forEach(function(v){ %>
              <div class="video-extra-item">
                <span class="photo-label"><%= v.titulo %></span>
                <video class="modo-video" controls preload="none"<% if (v.poster) { %> poster="<%= v.poster %>"<% } %>>
                  <source src="<%= v.src %>" type="video/mp4">
                </video>
              </div>
            <% }) %>
          </div>
        <% } %>

        <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent(tv('detalle_servicio.whatsapp_presupuesto', { servicio: modo.nombre.toLowerCase() })) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg cta-block">
          <%= t('detalle_servicio.cta_presupuesto') %>
        </a>
      </div>

      <div class="example-panel">
        <h2 class="sub-heading"><%= tv('detalle_servicio.ejemplo_real.title', { titulo: modo.ejemplo.titulo }) %></h2>

        <div class="options-stack">
          <% modo.ejemplo.opciones.forEach(function(op){ %>
            <%- include('../partials/option-card', { op: op, fmt: fmt, serviceNombre: modo.nombre, empresa: empresa }) %>
          <% }) %>
        </div>

        <% if (modo.ejemplo.nota) { %>
          <p class="example-note"><%= modo.ejemplo.nota %></p>
        <% } %>

        <p class="orientative-note"><%= t('detalle_servicio.nota_orientativa') %></p>
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= tv('ia_modo.cta_final.title', { servicio: modo.nombre.toLowerCase() }) %></h2>
      <p><%= t('detalle_servicio.cta_final.subtitle') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent(tv('detalle_servicio.whatsapp_presupuesto', { servicio: modo.nombre.toLowerCase() })) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
