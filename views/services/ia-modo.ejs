<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/gtm-body') %>
  <%- include('../partials/header') %>

  <section class="service-hero service-hero-ai<%= modo.imagen ? ' service-hero-photo' : '' %>">
    <% if (modo.imagen) { %>
      <img class="service-hero-bg" src="<%= modo.imagen %>" alt="" loading="eager">
      <div class="service-hero-overlay"></div>
    <% } %>
    <div class="container service-hero-inner">
      <div class="service-hero-icon"><svg viewBox="0 0 24 24"><%- icons[modo.icono] %></svg></div>
      <div>
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <a href="/servicios">Servicios</a> ›
          <a href="/servicios/ia-predictiva">Plataforma IA Predictiva</a>
        </nav>
        <span class="eyebrow">Modo <%= modo.numero %> de <%= totalModos %> — <%= modo.subtitulo %></span>
        <% if (modo.titular) { %><p class="hero-titular"><%= modo.titular %></p><% } %>
        <h1><%= modo.nombre %></h1>
        <p><%= modo.resumen %></p>
        <div class="service-meta">
          <span class="meta-chip meta-chip-price">+ <%= fmt(modo.precioIncremento) %> € sobre el Mini-PC IA Central</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2 class="sub-heading">Ideal para</h2>
        <ul class="check-list check-list-lg">
          <% modo.idealPara.forEach(function(item){ %>
            <li><%= item %></li>
          <% }) %>
        </ul>

        <div class="ia-modo-info-box">
          <p><strong>Requiere el Mini-PC IA Central</strong></p>
          <p>Este modo cuesta <strong><%= fmt(modo.precioIncremento) %> €</strong> adicionales sobre el <a href="/servicios/ia-predictiva">Mini-PC IA Central (desde 590 €, obligatorio)</a> — reutiliza el mismo mini-PC y el mismo motor Python que el resto de modos. Ya no se instala con equipo propio independiente.</p>
        </div>

        <% if (modo.video) { %>
          <div class="modo-video-wrap">
            <video class="modo-video" controls preload="none" poster="<%= modo.imagen %>">
              <source src="<%= modo.video %>" type="video/mp4">
            </video>
          </div>
        <% } %>

        <% if (modo.videosExtra && modo.videosExtra.length) { %>
          <div class="video-extra-grid">
            <% modo.videosExtra.forEach(function(v){ %>
              <div class="video-extra-item">
                <span class="photo-label"><%= v.titulo %></span>
                <video class="modo-video" controls preload="none"<% if (v.poster) { %> poster="<%= v.poster %>"<% } %>>
                  <source src="<%= v.src %>" type="video/mp4">
                </video>
              </div>
            <% }) %>
          </div>
        <% } %>

        <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent('Hola, quiero pedir presupuesto para ' + modo.nombre.toLowerCase()) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg cta-block">
          Pedir presupuesto gratuito
        </a>
      </div>

      <div class="example-panel">
        <h2 class="sub-heading">Ejemplo real — <%= modo.ejemplo.titulo %></h2>

        <div class="options-stack">
          <% modo.ejemplo.opciones.forEach(function(op){ %>
            <%- include('../partials/option-card', { op: op, fmt: fmt }) %>
          <% }) %>
        </div>

        <% if (modo.ejemplo.nota) { %>
          <p class="example-note"><%= modo.ejemplo.nota %></p>
        <% } %>

        <p class="orientative-note">Todos los importes son orientativos. El precio definitivo se confirma tras la visita técnica gratuita.</p>
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2>¿Empezamos con <%= modo.nombre.toLowerCase() %>?</h2>
      <p>Primera visita gratuita. Presupuesto sin compromiso.</p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent('Hola, quiero pedir presupuesto para ' + modo.nombre.toLowerCase()) %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
