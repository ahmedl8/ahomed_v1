<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/gtm-body') %>
  <%- include('../partials/header') %>

  <section class="service-hero service-hero-ai service-hero-photo">
    <img class="service-hero-bg" src="/img/hero-bloques/ia-monitorizacion.jpg" alt="" loading="eager">
    <div class="service-hero-overlay"></div>
    <div class="container service-hero-inner">
      <div class="service-hero-icon"><svg viewBox="0 0 24 24"><%- icons.ai %></svg></div>
      <div>
        <nav class="breadcrumb" aria-label="<%= t('common.breadcrumb_aria') %>">
          <a href="/servicios"><%= t('nav.servicios') %></a> ›
          <a href="/servicios/bloque/ia-predictiva"><%= t('nav.plataforma_ia') %></a>
        </nav>
        <span class="eyebrow"><%= instalacionBase.marca %> — <%= instalacionBase.tagline %></span>
        <h1><%= t('nav.plataforma_ia') %></h1>
        <p><%= tv('ia_predictiva.hero.body', { marca: instalacionBase.marca }) %></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="sub-heading"><%= tv('ia_predictiva.s1.title', { marca: instalacionBase.marca }) %></h2>
      <p class="cerebro-hardware-note-light"><%- tv('ia_predictiva.s1.hardware_note', { tagline: instalacionBase.tagline }) %></p>
      <p><%= instalacionBase.resumen %></p>

      <div class="options-stack options-stack-2">
        <% instalacionBase.niveles.forEach(function(nivel, i){ %>
          <div class="option-card <%= i === 1 ? 'option-card-featured' : '' %>">
            <% if (i === 1) { %><span class="option-star"><%= nivel.subtitulo %></span><% } else { %><span class="option-star option-star-neutral"><%= nivel.subtitulo %></span><% } %>
            <h3><%= nivel.nombre %></h3>
            <p class="option-card-desc"><%= nivel.resumen %></p>
            <table class="option-table">
              <tbody>
                <% nivel.items.forEach(function(item){ %>
                  <tr>
                    <td><%= item[0] %></td>
                    <td class="option-price"><%= fmt(item[1]) %> €</td>
                  </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr>
                  <td><%= t('common.total') %> — <%= nivel.nombre %></td>
                  <td class="option-price option-total"><%= fmt(nivel.total) %> €</td>
                </tr>
              </tfoot>
            </table>
          </div>
        <% }) %>
      </div>

      <p class="example-note"><%= t('ia_predictiva.s1.example_note') %></p>
    </div>
  </section>

  <% if (packsIA && packsIA.length) { %>
  <section class="section section-alt">
    <div class="container">
      <h2 class="sub-heading"><%= t('ia_predictiva.s2.title') %></h2>
      <p><%= t('ia_predictiva.s2.desc') %></p>

      <div class="packs-grid packs-grid-2">
        <% packsIA.forEach(function(p){ %>
          <a href="/soluciones#<%= p.slug %>" class="pack-card pack-card-photo">
            <img src="<%= p.imagen %>" alt="<%= p.imagenAlt %>" loading="lazy" class="pack-card-img">
            <div class="pack-card-body">
              <% if (p.incluyeIA) { %><span class="pack-ia-badge pack-ia-badge-sm"><%= t('packs.badge.incluye_ia') %></span><% } %>
              <h3><%= p.nombre %></h3>
              <p class="pack-desc"><%= p.descripcion %></p>
              <div class="pack-footer">
                <span class="price-tag price-tag-lg"><%= t('common.desde') %> <%= fmt(p.opciones[0].total) %> €</span>
                <span class="btn btn-outline"><%= t('ia_predictiva.s2.ver_desglose') %></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- CALCULADORA -->
  <section class="section" id="calculadora">
    <div class="container">
      <h2 class="sub-heading"><%= t('ia_predictiva.s3.title') %></h2>
      <p><%= t('ia_predictiva.s3.desc') %></p>

      <div class="calc-wrap" data-wa="<%= empresa.whatsapp %>">
        <div class="calc-niveles">
          <% instalacionBase.niveles.forEach(function(nivel, i){ %>
            <label class="calc-nivel-card">
              <input type="radio" name="calc-nivel" class="calc-nivel-radio" value="<%= nivel.total %>" data-nombre="<%= nivel.nombre %>" <%= i === 0 ? 'checked' : '' %>>
              <span class="calc-nivel-title"><%= nivel.nombre %> <span class="calc-nivel-price"><%= fmt(nivel.total) %> €</span></span>
              <span class="calc-nivel-sub"><%= nivel.subtitulo %></span>
            </label>
          <% }) %>
        </div>
        <p class="calc-nivel-hint" id="calc-nivel-hint"></p>

        <div class="calc-modos">
          <% modos.forEach(function(m){ %>
            <label class="calc-item">
              <span class="calc-item-check"><input type="checkbox" class="calc-check" data-precio="<%= m.esProyecto ? 860 : m.precioIncremento %>" data-nombre="<%= m.nombre %>"><span class="calc-item-name"><%= m.numero %>. <%= m.nombre %><% if (m.esProyecto) { %> <em><%= t('ia_predictiva.s3.desde_proyecto') %></em><% } %></span></span>
              <span class="calc-item-price">+<%= fmt(m.esProyecto ? 860 : m.precioIncremento) %> €</span>
            </label>
          <% }) %>
        </div>

        <div class="calc-summary">
          <h3><%= t('ia_predictiva.s3.calc_title') %></h3>
          <div class="calc-total-row"><span id="calc-base-label"><%= t('ia_predictiva.s3.minipc_label') %></span><span id="calc-base"><%= fmt(instalacionBase.niveles[0].total) %> €</span></div>
          <div class="calc-total-row"><span><%= t('ia_predictiva.s3.modos_seleccionados') %></span><span id="calc-extra">+0 €</span></div>
          <div class="calc-total-row calc-total-final"><span><%= t('ia_predictiva.s3.total_estimado') %></span><span id="calc-total"><%= fmt(instalacionBase.niveles[0].total) %> €</span></div>
          <a href="#" id="calc-whatsapp" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg calc-cta"><%= t('ia_predictiva.s3.enviar_whatsapp') %></a>
          <p class="calc-disclaimer"><%= t('ia_predictiva.s3.disclaimer') %></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="sub-heading"><%= tv('ia_predictiva.s4.title', { n: modos.length }) %></h2>
      <p><%= t('ia_predictiva.s4.desc') %></p>

      <% familiasIA.forEach(function(familia){ %>
        <div class="ia-familia-group" id="familia-<%= familia.slug %>">
          <div class="ia-familia-head">
            <div class="service-icon service-icon-img">
              <picture>
                <source srcset="<%= familia.imagen %>.webp" type="image/webp">
                <img src="<%= familia.imagen %>.png" alt="<%= familia.nombre %>" loading="lazy">
              </picture>
            </div>
            <div>
              <h3><%= familia.nombre %></h3>
              <p><%= familia.resumen %></p>
            </div>
          </div>
          <div class="services-grid services-grid-full">
            <% modos.filter(function(m){ return m.familia === familia.slug; }).forEach(function(m){ %>
              <a href="/servicios/ia-predictiva/<%= m.slug %>" class="service-card service-card-ia-modo<%= m.esProyecto ? ' service-card-ai' : '' %>">
                <% if (m.esProyecto) { %><div class="service-badge"><%= t('servicios.badge.exclusivo') %></div><% } %>
                <% if (m.titular) { %><p class="card-titular"><%= m.titular %></p><% } %>
                <h3><%= m.numero %>. <%= m.nombre %></h3>
                <p><%= m.esProyecto ? m.subtitulo : m.resumen %></p>
                <div class="service-card-footer">
                  <span class="price-tag"><%= m.esProyecto ? t('servicios.precio.proyecto_medida') : tv('servicios.precio.sobre_base', { precio: fmt(m.precioIncremento) }) %></span>
                  <span class="link-arrow"><%= t('common.ver_detalle') %> →</span>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      <% }) %>

      <p class="orientative-note"><%- t('ia_predictiva.s4.orientative_note') %></p>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('ia_predictiva.final_cta.title') %></h2>
      <p><%= t('ia_predictiva.final_cta.body') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('ia_predictiva.final_cta.whatsapp_text') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <script src="/js/calculadora-ia.js" defer></script>
</body>
</html>
