<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1>Servicios</h1>
      <% var numeroEnLetra = ["", "un", "dos", "tres", "cuatro", "cinco", "seis", "siete", "ocho", "nueve", "diez"][bloques.length] || bloques.length; %>
      <p><%= numeroEnLetra.charAt(0).toUpperCase() + numeroEnLetra.slice(1) %> bloques, un mismo equipo. Precios orientativos: el presupuesto final se confirma tras la visita técnica gratuita.</p>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="bloques-grid-wrap">
        <div class="bloques-grid-group">
          <span class="bloques-grid-label">Básicos</span>
          <div class="bloques-grid">
            <% bloques.filter(function(b){ return b.grupo === 'basico'; }).forEach(function(b){ %>
              <a href="#bloque-<%= b.slug %>" class="bloque-chip">
                <span><%= b.nombre %></span>
              </a>
            <% }) %>
          </div>
        </div>
        <div class="bloques-grid-group">
          <span class="bloques-grid-label bloques-grid-label-ia">Exclusivos · con IA</span>
          <div class="bloques-grid">
            <% bloques.filter(function(b){ return b.grupo === 'exclusivo' && b.publico !== 'negocio'; }).forEach(function(b){ %>
              <a href="#bloque-<%= b.slug %>" class="bloque-chip bloque-chip-ia">
                <span><%= b.nombre %></span>
              </a>
            <% }) %>
          </div>
        </div>
        <div class="bloques-grid-group">
          <span class="bloques-grid-label">Transversal</span>
          <div class="bloques-grid">
            <% bloques.filter(function(b){ return b.grupo === 'general'; }).forEach(function(b){ %>
              <a href="#bloque-<%= b.slug %>" class="bloque-chip">
                <span><%= b.nombre %></span>
              </a>
            <% }) %>
          </div>
        </div>
        <div class="bloques-grid-group">
          <span class="bloques-grid-label">Para tu negocio</span>
          <div class="bloques-grid">
            <a href="#grupo-naves-fincas" class="bloque-chip">
              <span>🏭 Naves y Fincas</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-group-header" id="grupo-basicos">
    <div class="container">
      <span class="section-group-eyebrow">🔧 Básicos</span>
      <h2 class="section-group-title">Servicios sin IA</h2>
      <p class="section-group-desc">Instalaciones tradicionales: electricidad, domótica de control por app, seguridad con grabación local y climatización. Opciones claras, presupuesto personalizado.</p>
    </div>
  </section>

  <% bloques.filter(function(b){ return b.grupo === 'basico'; }).forEach(function(b){ %>
    <section class="section" id="bloque-<%= b.slug %>">
      <div class="container">
        <div class="bloque-header">
          <div>
            <h2><%= b.nombre %></h2>
            <p><%= b.resumen %></p>
          </div>
        </div>

        <div class="services-grid services-grid-full">
          <% services.filter(function(s){ return s.bloque === b.slug && s.publico !== 'negocio'; }).forEach(function(s){ %>
            <a href="/servicios/<%= s.slug %>" class="service-card">
              <h3><%= s.numero %>. <%= s.nombre %></h3>
              <p><%= s.resumen %></p>
              <div class="service-meta">
                <span class="meta-chip"><%= s.tiempo %></span>
              </div>
              <div class="service-card-footer">
                <span class="link-arrow">Ver detalle y precio →</span>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  <% }) %>

  <section class="section-group-header section-group-header-ia" id="grupo-exclusivos">
    <div class="container">
      <span class="section-group-eyebrow">🧠 Exclusivos</span>
      <h2 class="section-group-title">Con Inteligencia Artificial</h2>
      <p class="section-group-desc">Un mismo Mini-PC IA Central hace de cerebro para todos estos servicios: analiza cámaras, cruza datos de clima y presencia, y avisa por WhatsApp solo cuando de verdad importa. Sin cuota mensual, todo el procesamiento en tu casa.</p>
    </div>
  </section>

  <% bloques.filter(function(b){ return b.grupo === 'exclusivo' && b.publico !== 'negocio'; }).forEach(function(b){ %>
    <section class="section <%= b.slug === 'ia-predictiva' ? 'section-alt' : '' %>" id="bloque-<%= b.slug %>">
      <div class="container">
        <div class="bloque-header">
          <div>
            <h2><%= b.nombre %></h2>
            <p><%= b.resumen %></p>
          </div>
        </div>

        <div class="services-grid services-grid-full">
          <% services.filter(function(s){ return s.bloque === b.slug; }).forEach(function(s){ %>
            <a href="/servicios/<%= s.slug %>" class="service-card">
              <h3><%= s.numero %>. <%= s.nombre %></h3>
              <p><%= s.resumen %></p>
              <div class="service-meta">
                <span class="meta-chip"><%= s.tiempo %></span>
              </div>
              <div class="service-card-footer">
                <span class="link-arrow">Ver detalle y precio →</span>
              </div>
            </a>
          <% }) %>

          <% if (b.slug === 'ia-predictiva') { %>
            <% modosIA.forEach(function(m){ %>
              <a href="/servicios/ia-predictiva/<%= m.slug %>" class="service-card service-card-ia-modo<%= m.esProyecto ? ' service-card-ai' : '' %>">
                <% if (m.esProyecto) { %><div class="service-badge">Servicio exclusivo</div><% } %>
                <% if (m.titular) { %><p class="card-titular"><%= m.titular %></p><% } %>
                <h3><%= m.numero %>. <%= m.nombre %></h3>
                <p><%= m.esProyecto ? m.subtitulo : m.resumen %></p>
                <div class="service-card-footer">
                  <span class="link-arrow">Ver detalle y precio →</span>
                </div>
              </a>
            <% }) %>
          <% } %>
        </div>

        <% if (b.slug === 'ia-predictiva') { %>
          <a href="/servicios/ia-predictiva" class="bloque-cta-link">Ver cómo funciona la plataforma completa →</a>
        <% } %>
      </div>
    </section>
  <% }) %>

  <section class="section-group-header section-group-header-neutral" id="grupo-mantenimiento">
    <div class="container">
      <span class="section-group-eyebrow">🔧 Transversal</span>
      <h2 class="section-group-title">Mantenimiento</h2>
      <p class="section-group-desc">Para cualquier instalación AHOMED, básica o con IA: revisiones, incidencias y reentrenamiento del modelo cuando aplica.</p>
    </div>
  </section>

  <% bloques.filter(function(b){ return b.slug === 'mantenimiento'; }).forEach(function(b){ %>
    <section class="section" id="bloque-<%= b.slug %>">
      <div class="container">
        <div class="services-grid services-grid-full">
          <% services.filter(function(s){ return s.bloque === b.slug && s.publico !== 'negocio'; }).forEach(function(s){ %>
            <a href="/servicios/<%= s.slug %>" class="service-card">
              <h3><%= s.nombre %></h3>
              <p><%= s.resumen %></p>
              <div class="service-meta">
                <span class="meta-chip"><%= s.tiempo %></span>
              </div>
              <div class="service-card-footer">
                <span class="link-arrow">Ver detalle y precio →</span>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  <% }) %>

  <section class="section-group-header section-group-header-neutral" id="grupo-naves-fincas">
    <div class="container">
      <span class="section-group-eyebrow">🏭 Naves y Fincas</span>
      <h2 class="section-group-title">Para tu negocio</h2>
      <p class="section-group-desc">Los mismos servicios básicos (electricidad, redes, fontanería, mantenimiento) adaptados a otra escala, más Seguridad IA perimetral para naves, almacenes y fincas. Todo separado de la parte residencial — otro dimensionado, otro tipo de proyecto.</p>
    </div>
  </section>

  <section class="section" id="bloque-naves-fincas-basicos">
    <div class="container">
      <h2 class="sub-heading">Instalaciones y servicios</h2>
      <div class="services-grid services-grid-full">
        <% services.filter(function(s){ return s.publico === 'negocio'; }).forEach(function(s){ %>
          <a href="/servicios/<%= s.slug %>" class="service-card">
            <h3><%= s.nombre %></h3>
            <p><%= s.resumen %></p>
            <div class="service-meta">
              <span class="meta-chip"><%= s.tiempo %></span>
            </div>
            <div class="service-card-footer">
              <span class="link-arrow">Ver detalle y precio →</span>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <% if (typeof seguridadIANaves !== 'undefined' && seguridadIANaves) { %>
    <section class="section section-alt" id="bloque-seguridad-ia-naves-fincas">
      <div class="container">
        <h2 class="sub-heading">Con inteligencia artificial</h2>
        <div class="services-grid services-grid-full">
          <a href="/servicios/naves-fincas/seguridad-ia" class="service-card service-card-ia-modo service-card-ai">
            <div class="service-badge">Servicio exclusivo</div>
            <p class="card-titular"><%= seguridadIANaves.titular %></p>
            <h3><%= seguridadIANaves.nombre %></h3>
            <p><%= seguridadIANaves.subtitulo %></p>
            <div class="service-card-footer">
              <span class="link-arrow">Ver detalle y precio →</span>
            </div>
          </a>
        </div>
        <a href="/soluciones#packs-negocio" class="bloque-cta-link">Ver soluciones para tu negocio →</a>
      </div>
    </section>
  <% } %>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2>¿No encuentras el servicio?</h2>
      <p>Nuestro fuerte es la capa inteligente de la vivienda: seguridad con IA, domótica, redes y energía. Para pintura, alicatado, fontanería o pladur puntual — normalmente como <a href="/servicios/bloque/reformas">apoyo a una instalación AHOMED</a> — consúltanos también, y si trabajas con una reforma o construcción en marcha, mira <a href="/para-profesionales">AHOMED para Profesionales</a>.</p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=Hola%2C%20tengo%20una%20consulta" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">Consultar por WhatsApp</a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
