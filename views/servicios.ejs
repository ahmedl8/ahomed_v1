<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1><%= t('nav.servicios') %></h1>
      <p><%= t('servicios.hero.subtitle') %></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="services-grid home-services-grid">
        <% services.forEach(function(s){ %>
          <a href="<%= pathHref('/servicios/' + s.slug) %>" class="service-card service-card-photo">
            <div class="service-card-media">
              <img src="<%= s.cardImagen %>" alt="<%= s.nombre %>" loading="lazy" width="400" height="300">
            </div>
            <div class="service-card-body">
              <h3><%= s.numero %>. <%= s.nombre %></h3>
              <p><%= s.resumen %></p>
              <div class="service-meta">
                <span class="meta-chip"><%= s.tiempo %></span>
              </div>
              <div class="service-card-footer">
                <span class="price-tag"><%= t('common.desde') %> <%= fmt(s.desde) %> €</span>
                <span class="link-arrow"><%= t('common.ver_detalle') %> →</span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('servicios.final_cta.title') %></h2>
      <p><%- tv('servicios.final_cta.body', { profesionales: pathHref('/para-profesionales') }) %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('servicios.final_cta.whatsapp_text') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg"><%= t('servicios.final_cta.cta') %></a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
