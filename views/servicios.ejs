<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <h1><%= t('nav.servicios') %></h1>
      <p><%= t('servicios.hero.subtitle') %></p>
    </div>
  </section>

  <section class="family-nav-wrap">
    <div class="container">
      <nav class="family-nav" aria-label="<%= t('servicios.familias.nav_aria') %>">
        <% familias.forEach(function(f){ %>
          <a href="#<%= f.slug %>" class="family-nav-chip"><span class="family-nav-num"><%= String(f.numero).padStart(2, '0') %></span><%= f.nombre %></a>
        <% }) %>
      </nav>
    </div>
  </section>

  <% familias.forEach(function(f){ %>
    <section class="section section-tight family-section" id="<%= f.slug %>">
      <div class="container">
        <div class="family-section-head">
          <span class="family-section-num"><%= String(f.numero).padStart(2, '0') %></span>
          <div>
            <h2><%= f.nombre %></h2>
            <p><%= f.lema %></p>
          </div>
        </div>
        <div class="services-grid family-services-grid">
          <% f.items.forEach(function(s){ %>
            <a href="<%= pathHref('/servicios/' + s.slug) %>" class="service-card service-card-photo">
              <% if (s.cardImagen) { %>
                <div class="service-card-media">
                  <img src="<%= s.cardImagen %>" alt="<%= s.nombre %>" loading="lazy" width="400" height="300">
                </div>
              <% } else { %>
                <div class="service-card-media service-card-media-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><%- icons[s.icono] %></svg>
                </div>
              <% } %>
              <div class="service-card-body">
                <h3><%= s.nombre %></h3>
                <p><%= s.resumen %></p>
                <div class="service-meta">
                  <span class="meta-chip"><%= s.tiempo %></span>
                </div>
                <div class="service-card-footer">
                  <span class="price-tag"><%= t('common.desde') %> <%= fmt(s.desde) %> €<%= s.desdeUnidad || '' %></span>
                  <span class="link-arrow"><%= t('common.ver_detalle') %> →</span>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  <% }) %>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('servicios.final_cta.title') %></h2>
      <p><%- tv('servicios.final_cta.body', { profesionales: pathHref('/para-profesionales') }) %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('servicios.final_cta.whatsapp_text') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg"><%= t('servicios.final_cta.cta') %></a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
