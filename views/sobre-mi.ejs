<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero about-hero">
    <div class="container about-hero-inner">
      <div class="about-photo">
        <img src="/img/ahmed-sobre-mi.jpg" alt="<%= t('sobre_mi.hero.photo_alt') %>" loading="eager" />
      </div>
      <div>
        <h1><%= t('sobre_mi.hero.title') %></h1>
        <p class="about-lead"><%= t('sobre_mi.hero.subtitle') %></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2 class="sub-heading"><%= t('sobre_mi.experiencia.title') %></h2>
        <p><%= t('sobre_mi.experiencia.p1') %></p>
        <p><%= t('sobre_mi.experiencia.p2') %></p>

        <h2 class="sub-heading"><%= t('sobre_mi.areas.title') %></h2>
        <ul class="dot-list dot-list-cols">
          <% [
            t('sobre_mi.areas.item1'),
            t('sobre_mi.areas.item2'),
            t('sobre_mi.areas.item3'),
            t('sobre_mi.areas.item4'),
            t('sobre_mi.areas.item5'),
            t('sobre_mi.areas.item6'),
            t('sobre_mi.areas.item7'),
            t('sobre_mi.areas.item8')
          ].forEach(function(v){ %>
            <li><%= v %></li>
          <% }) %>
        </ul>
      </div>

      <div class="about-side">
        <div class="about-card">
          <h3><%= t('sobre_mi.por_que.title') %></h3>
          <ul class="check-list check-list-lg">
            <% [
              t('sobre_mi.por_que.item1'),
              t('sobre_mi.por_que.item2'),
              t('sobre_mi.por_que.item3'),
              t('sobre_mi.por_que.item4'),
              t('sobre_mi.por_que.item5'),
              t('sobre_mi.por_que.item6')
            ].forEach(function(v){ %>
              <li><%= v %></li>
            <% }) %>
          </ul>
        </div>
        <div class="about-card">
          <h3><%= t('sobre_mi.zona.title') %></h3>
          <p><%= empresa.zona %></p>
          <a href="https://wa.me/34<%= empresa.whatsapp %>" target="_blank" rel="noopener" class="btn btn-whatsapp cta-block">WhatsApp <%= empresa.whatsappDisplay %></a>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
