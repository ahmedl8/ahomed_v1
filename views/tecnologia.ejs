<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/gtm-body') %>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <span class="eyebrow"><%= instalacionBase.marca %></span>
      <h1><%= t('tecnologia.hero.title') %></h1>
      <p><%= instalacionBase.tagline %> <%= t('tecnologia.hero.subtitle') %></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="tech-grid">

        <div class="tech-card">
          <div class="service-icon service-icon-img"><picture><source srcset="/img/iconos/minipc-central.webp" type="image/webp"><img src="/img/iconos/minipc-central.png" alt=""></picture></div>
          <h3><%= t('tecnologia.card_cerebro.title') %></h3>
          <p><%= t('tecnologia.card_cerebro.text') %></p>
        </div>

        <div class="tech-card">
          <div class="service-icon service-icon-img"><picture><source srcset="/img/iconos/tech-ia-local.webp" type="image/webp"><img src="/img/iconos/tech-ia-local.png" alt=""></picture></div>
          <h3><%= t('tecnologia.card_local.title') %></h3>
          <p><%= t('tecnologia.card_local.text') %></p>
        </div>

        <div class="tech-card">
          <div class="service-icon service-icon-img"><picture><source srcset="/img/iconos/tech-video.webp" type="image/webp"><img src="/img/iconos/tech-video.png" alt=""></picture></div>
          <h3><%= t('tecnologia.card_video.title') %></h3>
          <p><%= t('tecnologia.card_video.text') %></p>
          <p class="tech-card-detail"><%- t('tecnologia.card_video.detail') %></p>
        </div>

        <div class="tech-card">
          <div class="service-icon service-icon-img"><picture><source srcset="/img/iconos/tech-automatizacion.webp" type="image/webp"><img src="/img/iconos/tech-automatizacion.png" alt=""></picture></div>
          <h3><%= t('tecnologia.card_automatizacion.title') %></h3>
          <p><%= t('tecnologia.card_automatizacion.text') %></p>
        </div>

        <div class="tech-card">
          <div class="service-icon service-icon-img"><picture><source srcset="/img/iconos/tech-dashboard.webp" type="image/webp"><img src="/img/iconos/tech-dashboard.png" alt=""></picture></div>
          <h3><%= t('tecnologia.card_dashboard.title') %></h3>
          <p><%= t('tecnologia.card_dashboard.text') %></p>
        </div>

        <div class="tech-card">
          <div class="service-icon service-icon-img"><picture><source srcset="/img/iconos/tech-whatsapp-api.webp" type="image/webp"><img src="/img/iconos/tech-whatsapp-api.png" alt=""></picture></div>
          <h3><%= t('tecnologia.card_whatsapp.title') %></h3>
          <p><%= t('tecnologia.card_whatsapp.text') %></p>
        </div>

        <div class="tech-card">
          <div class="service-icon service-icon-img"><picture><source srcset="/img/iconos/tech-integraciones.webp" type="image/webp"><img src="/img/iconos/tech-integraciones.png" alt=""></picture></div>
          <h3><%= t('tecnologia.card_integraciones.title') %></h3>
          <p><%= t('tecnologia.card_integraciones.text') %></p>
        </div>

        <div class="tech-card">
          <div class="service-icon service-icon-img"><picture><source srcset="/img/iconos/tech-sin-cuotas.webp" type="image/webp"><img src="/img/iconos/tech-sin-cuotas.png" alt=""></picture></div>
          <h3><%= t('tecnologia.card_sin_cuotas.title') %></h3>
          <p><%= t('tecnologia.card_sin_cuotas.text') %></p>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <h2><%= t('tecnologia.modos.title') %></h2>
        <p><%= t('tecnologia.modos.text') %></p>
      </div>
      <div class="tech-compare-cta"><a href="/servicios/ia-predictiva" class="btn btn-outline"><%= t('tecnologia.modos.cta') %></a></div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2><%= t('tecnologia.cta.title') %></h2>
      <p><%= t('tecnologia.cta.subtitle') %></p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= t('tecnologia.cta.whatsapp_text') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
