<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <section class="page-hero">
    <div class="container">
      <a href="/trabajos-reales" class="back-link">← Volver a trabajos reales</a>
      <span class="work-cat work-cat-standalone"><%= trabajo.categoria %></span>
      <h1><%= trabajo.titulo %></h1>
      <p><%= trabajo.descripcion %></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="before-after">
        <figure class="before-after-item">
          <div class="before-after-frame">
            <img src="<%= trabajo.imagenAntes %>" alt="Antes — <%= trabajo.titulo %>" loading="lazy">
            <span class="before-after-tag before-after-tag-antes">Antes</span>
          </div>
        </figure>
        <figure class="before-after-item">
          <div class="before-after-frame">
            <img src="<%= trabajo.imagen %>" alt="Después — <%= trabajo.titulo %>" loading="lazy">
            <span class="before-after-tag before-after-tag-despues">Después</span>
          </div>
        </figure>
      </div>

      <% if (trabajo.video) { %>
        <div class="work-video-block">
          <h2 class="sub-heading">Vídeo del trabajo</h2>
          <video class="work-video" controls playsinline preload="metadata" poster="<%= trabajo.videoPoster %>">
            <source src="<%= trabajo.video %>" type="video/mp4">
          </video>
        </div>
      <% } %>

      <div class="work-detail-body">
        <h2 class="sub-heading">Qué se hizo</h2>
        <p class="work-detail-desc"><%= trabajo.descripcion %></p>

        <a href="https://wa.me/34<%= empresa.whatsapp %>?text=<%= encodeURIComponent('Hola, he visto vuestro trabajo de ' + trabajo.titulo.toLowerCase() + ' y quiero pedir presupuesto para algo parecido') %>" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg cta-block">
          Pedir presupuesto para un trabajo así
        </a>
      </div>

      <% if (relacionados && relacionados.length) { %>
        <div class="section-head related-head">
          <h2>Más trabajos de <%= trabajo.categoria %></h2>
        </div>
        <div class="works-grid works-grid-page">
          <% relacionados.forEach(function(t){ %>
            <a href="/trabajos-reales/<%= t.slug %>" class="work-item">
              <img src="<%= t.imagen %>" alt="<%= t.titulo %>" loading="lazy">
              <div class="work-caption">
                <span class="work-cat"><%= t.categoria %></span>
                <div class="work-title"><%= t.titulo %></div>
              </div>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container final-cta-inner">
      <h2>¿Quieres un resultado parecido en tu casa o negocio?</h2>
      <p>Primera visita gratuita. Presupuesto sin compromiso.</p>
      <a href="https://wa.me/34<%= empresa.whatsapp %>?text=Hola%2C%20quiero%20pedir%20presupuesto%20gratuito" target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <%= empresa.whatsappDisplay %>
      </a>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
